  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept3778">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-24T11:22:11+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="ar">بث انتقايي للمعلومات</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Difusion selectiva de informacion</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Perfil de interes</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Diffusion selective</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Diffusion selective de l'information</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Profil d'interet</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">بث انتقائي للمعلومات</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Selective dissemination of information</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Difusión selectiva de información</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Diffusion sélective de l'information</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Избирательное распространение информации</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">خدمة تنشر باستمرار الوثائق والمراجع و"الملخصات" والبيانات التي يتم اختيارها طبقا لسمات اهتمام المستفيدين.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">A service which continually disseminates documents, references, "abstracts" or data selected according to the interest profiles of the users.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Servicio que difunde de forma continua documentos, referencias, "extractos" o datos, seleccionados en función de los perfiles de interés de los usuarios.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Service qui diffuse de manière permanente des documents, références, "extraits" ou données choisis en fonction des profils d'intérêt des utilisateurs.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Информационная услуга, состоящая в систематической рассылке документов, рефератов или данных, подобранных в соответствии с информационным запросом пользователей.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">سمات الاهتمام</skos:altLabel>
    <skos:altLabel xml:lang="en">Interest profiles</skos:altLabel>
    <skos:altLabel xml:lang="en">SDI</skos:altLabel>
    <skos:altLabel xml:lang="es">DSI</skos:altLabel>
    <skos:altLabel xml:lang="es">Perfil de interés</skos:altLabel>
    <skos:altLabel xml:lang="fr">DSI</skos:altLabel>
    <skos:altLabel xml:lang="fr">Diffusion sélective</skos:altLabel>
    <skos:altLabel xml:lang="fr">Profil d'intérêt</skos:altLabel>
    <skos:altLabel xml:lang="ru">ИРИ - избирательное распространение информации</skos:altLabel>
    <skos:altLabel xml:lang="ru">Информационные запросы</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept512"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1028"/>
