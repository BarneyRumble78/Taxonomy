  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept3802">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:51:24+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Bibliologia</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Bibliometria</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Bibliometrie</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">ببليولوجيا</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Bibliology</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Bibliología</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Bibliologie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Библиология</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">الدراسة المنهجية لخصائص ومميزات الكتب المتعلقة بعملية النشر أو تقنيات الطباعة والإنتاج والتسويق.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">The systematic study of the properties and characteristics of books in relation to the publication process or to the techniques of printing, production and marketing.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Estudio sistemático de las propiedades y características de los libros en relación con los procesos de publicación o con las técnicas de impresión, producción y marketing.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Étude systématique des propriétés et caractéristiques des livres, axée sur les processus de publication ou les techniques d'impression, de production et de marketing.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Систематизированное изучение свойств и особенностей книг по отношению к издательскому процессу или технологии, производству и распространению печатной продукции.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">جمع الكتب</skos:altLabel>
    <skos:altLabel xml:lang="ar">علم الكتاب</skos:altLabel>
    <skos:altLabel xml:lang="ar">قياسات ببليوجرافية</skos:altLabel>
    <skos:altLabel xml:lang="en">Bibliometrics</skos:altLabel>
    <skos:altLabel xml:lang="en">Book collecting</skos:altLabel>
    <skos:altLabel xml:lang="es">Bibliofilia</skos:altLabel>
    <skos:altLabel xml:lang="es">Bibliometría</skos:altLabel>
    <skos:altLabel xml:lang="fr">Bibliométrie</skos:altLabel>
    <skos:altLabel xml:lang="fr">Bibliophilie</skos:altLabel>
    <skos:altLabel xml:lang="ru">Библиометрия</skos:altLabel>
    <skos:altLabel xml:lang="ru">Коллекционирование книг</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept456"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3809"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3810"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept10504">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-22T15:25:42+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Evaluacion formativa</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Evaluation formative</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">تقييم تكويني</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Formative evaluation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Evaluación formativa</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Évaluation formative</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Формативная оценка</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">نوع من التقييم يستخدم بشكل أساسي لتعديل وتحسين المنتجات أو البرامج أو الأنشطة أثناء تخطيطها وتطويرها.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">A type of assessment essentially used to modify and improve products, programmes or activities during their planning and development.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Tipo de valoración destinada a la modificación y mejora de productos, programas o actividades durante su planificación y desarrollo.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Type d'évaluation destinée essentiellement à modifier et à améliorer un produit, un programme ou une activité en cours de planification et de développement.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Данный метод оценки в основном применяется на стадии планирования или разработки в целях модификации и улучшения конечных продуктов, программ или деятельности.</skos:scopeNote>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept10507"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept10506"/>
  </rdf:Description>
