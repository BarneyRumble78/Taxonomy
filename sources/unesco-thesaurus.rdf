    <skos:hiddenLabel xml:lang="es">Reintegracion socioeconomica</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Reinsertion socio-economique</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Reintegration economique</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Reintegration socio-economique</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">إعادة الإدماج الاقتصادي</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Economic reintegration</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Reintegración económica</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Réintégration économique</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Экономическая pеинтеграция</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">استخدم للمحاربين السابقين والمدنيين العائدين.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Use for ex-combatants and returning civilians.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Úsese para ex-combatientes y civiles retornando a la vida social.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Utiliser pour les ex-combattants et les civils qui reviennent après un conflit.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Использовать для бывших комбатантов и возвращающегося гражданского населения.</skos:scopeNote>
    <skos:altLabel xml:lang="en">Economic and social reintegration</skos:altLabel>
    <skos:altLabel xml:lang="es">Reintegración social y económica</skos:altLabel>
    <skos:altLabel xml:lang="es">Reintegración socioeconómica</skos:altLabel>
    <skos:altLabel xml:lang="fr">Réinsertion socio-économique</skos:altLabel>
    <skos:altLabel xml:lang="fr">Réintégration socio-économique</skos:altLabel>
