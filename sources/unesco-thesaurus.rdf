    <skos:prefLabel xml:lang="ar">اقبال على التعليم</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Educational demand</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Demanda de educación</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Demande d'éducation</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Спрос на образование</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">إقبال المستهلكين على التعليم.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Consumer demand for education.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Demanda de educación por parte del consumidor.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Demande d'éducation de la part du consommateur.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Потребительский спрос на образование.</skos:scopeNote>
