    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:28:20+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Educacion y desarrollo</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Education et developpement</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">تعليم وتنمية</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Education and development</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Educación y desarrollo</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Éducation et développement</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Образование и развитие</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">يشير إلى دمج التعليم في عملية التنمية.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Refers to the integration of education into the development process.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Se refiere a la integración de la educación en el proceso de desarrollo.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Se réfère à l'intégration de l'éducation dans le processus de développement.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Относится к интеграции образования в процесс развития.</skos:scopeNote>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept13"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept5724"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept14"/>
