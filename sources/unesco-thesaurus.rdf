  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept6620">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:45:05+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Cuerpo comun de ensenanzas</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Programa obligatorio comun</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="ru">Базовыи курс</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="ru">Основнои курс</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">منهج محوري</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Core curriculum</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Programa obligatorio común</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Tronc commun</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Основной курс</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">الأجزاء الأساسية في مناهج المؤسسة التعليمية التي يدرسها جميع طلابها بغض النظر عن المواد الاختيارية التي قام الطلاب باختيارها.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Essential or basic parts of the curriculum of an educational institution that are studied by all its students even though each has a choice of optional subjects in addition.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Parte esencial del programa de una institución educativa impartido a la totalidad de los estudiantes, sean cuales sean las materias optativas elegidas por cada uno.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Partie essentielle du programme d'une institution éducative enseignée à l'ensemble de ses étudiants, quelles que soient les matières optionnelles choisies par ailleurs par chacun.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Главная, или базовая, часть учебного курса в образовательном учреждении, которую изучают все студенты, не зависимо от выбранных факультативных предметов.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">منهج اساسي</skos:altLabel>
    <skos:altLabel xml:lang="ar">منهج مشترك</skos:altLabel>
    <skos:altLabel xml:lang="en">Common core</skos:altLabel>
    <skos:altLabel xml:lang="es">Cuerpo común de enseñanzas</skos:altLabel>
    <skos:altLabel xml:lang="fr">Cours communs</skos:altLabel>
    <skos:altLabel xml:lang="fr">Programme de base</skos:altLabel>
    <skos:altLabel xml:lang="ru">Базовый курс</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept49"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept6622"/>
  </rdf:Description>
