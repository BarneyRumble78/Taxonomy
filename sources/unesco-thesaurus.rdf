  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept119">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:36:25+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="ar">طرق احصايية</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="ar">منهجية احصايية</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Estadistica</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Metodo estadistico</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Metodologia estadistica</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Methode statistique</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Methodologie statistique</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">احصاء</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Statistics</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Estadística</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Statistique</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Статистика</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">استخدم عند الإشارة إلى علم الإحصاء. لمجموعات الإحصاءات، استخدم "البيانات الإحصائية"، أو واصفة أكثر تحديدًا، على سبيل المثال، "الإحصاءات التعليمية"، إلخ.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Use when referring to the science of statistics. For collections of statistics, use "statistical data", or more specific descriptor, e.g. "educational statistics", etc.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Utilizar para referirse a la ciencia de la estadística. Para referirse a la recogida de informaciones estadísticas, emplear "dato estadístico" o un descriptor más específico como "estadística de la educación".</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Utiliser quand il s'agit de la science des statistiques. Pour la collecte de statistiques, utiliser "donnée statistique" ou un descripteur plus spécifique, p.ex. "statistique de l'éducation", etc.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Используется по отношению к статистической науке. В отношении собраний статистических данных используйте термин "Статистические данные" или более точный дескриптор, например, "Статистика в области образования" и пр.</skos:scopeNote>
    <skos:topConceptOf rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:altLabel xml:lang="ar">طرق احصائية</skos:altLabel>
    <skos:altLabel xml:lang="ar">منهجية احصائية</skos:altLabel>
    <skos:altLabel xml:lang="en">Statistical methodology</skos:altLabel>
    <skos:altLabel xml:lang="en">Statistical methods</skos:altLabel>
    <skos:altLabel xml:lang="es">Metodología estadística</skos:altLabel>
    <skos:altLabel xml:lang="es">Método estadístico</skos:altLabel>
    <skos:altLabel xml:lang="fr">Méthode statistique</skos:altLabel>
    <skos:altLabel xml:lang="fr">Méthodologie statistique</skos:altLabel>
    <skos:altLabel xml:lang="ru">Методология статистики</skos:altLabel>
    <skos:altLabel xml:lang="ru">Статистические методы</skos:altLabel>
    <skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept13824"/>
