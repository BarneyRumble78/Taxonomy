  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept3847">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:57:45+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Biblioteca publica</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Bibliotheque publique</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">مكتبات عامة</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Public libraries</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Biblioteca pública</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Bibliothèque publique</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Публичные библиотеки</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">مكتبة تخدم سكان مجتمع محلي أو منطقة مجانا أو مقابل رسوم رمزية.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">A library which serves the population of a community or region free of charge or for a nominal fee.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Biblioteca que ofrece un servicio público gratuito, o por un importe mínimo, a la población de una comunidad o de una región.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Bibliothèque desservant gratuitement ou pour une somme minime la population d'une communauté ou d'une région.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Библиотека, обслуживающая население сообщества или региона бесплатно или за номинальную плату.</skos:scopeNote>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept496"/>
    <skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3837"/>
    <skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3839"/>
    <skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3849"/>
    <skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3851"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept6973"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3841"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept3841">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:58:13+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="fr">Bibliotheque nationale</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">مكتبات وطنية</skos:prefLabel>
    <skos:prefLabel xml:lang="en">National libraries</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Biblioteca nacional</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Bibliothèque nationale</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Национальные библиотеки</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">المكتبة المسئولة عن الحصول على نسخ من جميع المنشورات الهامة الصادرة في البلد والمحافظة عليها، وقادرة على العمل كمكتبة إيداع.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">A 'library' which is responsible for acquiring and conserving copies of all significant publications published in the country and may function as a "legal deposit library".</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Biblioteca responsable de adquirir y conservar copias de todas las publicaciones importantes de un país, habilitada para funcionar como "biblioteca de depósito legal".</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Bibliothèque responsable de l'acquisition et de la conservation de copies de toutes les publications importantes d'un pays et habilitée à fonctionner en tant que "bibliothèque bénéficiant du dépôt légal".</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Библиотека, отвечающая за приобретение и сохранение экземпляров всех значимых изданий, выпущенных в стране, и способная выступать в качестве "депозитарной библиотеки".</skos:scopeNote>
    <skos:altLabel xml:lang="ar">مكتبات قومية</skos:altLabel>
    <skos:altLabel xml:lang="es">Biblioteca estatal</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept496"/>
    <skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3814"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3847"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3825"/>
  </rdf:Description>
