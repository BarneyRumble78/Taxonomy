  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept9652">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-21T23:41:15+00:00</dct:modified>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">عمالة كاملة</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Full employment</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Pleno empleo</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Plein emploi</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Полная занятость</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">حالة يتم فيها تزويد جميع الأشخاص الراغبين في العثور على وظيفة بوظائف مدفوعة الأجر.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Situation where all persons seeking employment have been provided with paid positions.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Situación en la cual toda la mano de obra disponible se ha podido beneficiar de un empleo remunerado.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Situation selon laquelle toute la main-d'oeuvre disponible a pu bénéficier d'un emploi rémunéré.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Ситуация, в которой все лица, заинтересованные найти работу, обеспечены оплачиваемыми рабочими местами.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">تشغيل كامل</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept682"/>
  </rdf:Description>
