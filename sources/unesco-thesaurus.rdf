    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:59:48+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="fr">Livre de l'annee</skos:hiddenLabel>
