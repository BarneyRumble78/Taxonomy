  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept13118">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:36:14+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="fr">Mobilite de la main-d'oeuvre</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">تنقل اليد العاملة</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Labour mobility</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Movilidad laboral</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Mobilité de la main-d'oeuvre</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Мобильность труда</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">قدرة العمال الأفراد على التحرك داخل وبين أسواق عمل محددة.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Ability of individual workers to move in and among labour markets.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Aptitud de trabajadores individuales de desplazarse para responder a las necesidades del mercado de trabajo.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Aptitude de travailleurs individuels à se déplacer pour répondre aux besoins des marchés du travail.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Способность отдельных работников передвигаться внутри и между конкретными рынками труда.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">حراك العمل</skos:altLabel>
    <skos:altLabel xml:lang="ar">حركة اليد العاملة</skos:altLabel>
    <skos:altLabel xml:lang="es">Movilidad de la mano de obra</skos:altLabel>
