    <skos:hiddenLabel xml:lang="es">Ensenanza gratuita</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Education non payante</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Education sans frais d'inscription</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Education sans frais de scolarite</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
