    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept5565"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept5573"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept5565">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:23:53+00:00</dct:modified>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">اتفاقيات جماعية</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collective agreements</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Convenio colectivo</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Convention collective</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Коллективные договоры</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">الاتفاق على ظروف العمل لمجموعة محددة من العمال،المبرم بين ممثلي العمال وأرباب العمل.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Agreement concerning the working conditions of a particular group of workers concluded between the workers' representatives and the employers.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Acuerdo referente a las condiciones de trabajo de un grupo determinado de trabajadores concluido entre los representantes de los trabajadores y el empresario.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Accord réglant les conditions de travail d'un groupe donné de travailleurs, conclu entre les représentants des travailleurs et l'employeur.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Соглашение об условиях труда конкретной группы работников, заключенное между представителями работников и работодателями.</skos:scopeNote>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept5573"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept5567"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept5569"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept5570"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept5568"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept5573">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:25:53+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Negociacion colectiva</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Negociation collective</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">مفاوضة جماعية</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collective bargaining</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Negociación colectiva</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Négociation collective</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Согласование коллективных договоров</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">عملية يقوم فيها ممثلو رب العمل والموظفين بمناقشة مختلف جوانب العلاقات الثنائية والاتفاق عليها من أجل التوصل إلى عقد عمل مقبول من الطرفين.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">The process by which representatives of employers and employees discuss and negotiate the various phases of their relationship with a view to arriving at a mutually acceptable labour agreement.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Conversaciones en las que los representantes de los trabajadores y los patronos analizan los diversos aspectos de su relación con el fin de llegar a un acuerdo de trabajo satisfactorio para las dos partes.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Pourparlers au cours desquels les représentants d'employeurs et d'employés traitent et débattent des différents aspects de leur relation, afin de parvenir à un accord de travail satisfaisant pour les deux parties.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Процесс, в ходе которого представители работодателя и работников обсуждают и согласовывают различные стороны двусторонних взаимоотношений с целью выработки взаимоприемлемого трудового договора.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">مساومة جماعية</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3212"/>
    <skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept5565"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept5569"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept5568"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept9921">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:35:39+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Ensenanza secundaria (2o nivel)</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Segundo ciclo de ensenanza secundaria</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Deuxieme cycle de l'enseignement secondaire</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="ru">Вторая ступень среднеи школы</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">تعليم ثانوي عالي</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Upper secondary education</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Enseñanza secundaria (2o nivel)</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Enseignement secondaire (2e cycle)</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Вторая ступень средней школы</skos:prefLabel>
    <skos:altLabel xml:lang="ar">تعليم ثانوي اعلى</skos:altLabel>
    <skos:altLabel xml:lang="ar">صف سادس في المدارس الثانوية</skos:altLabel>
    <skos:altLabel xml:lang="en">Sixth forms</skos:altLabel>
    <skos:altLabel xml:lang="es">Segundo ciclo de enseñanza secundaria</skos:altLabel>
    <skos:altLabel xml:lang="fr">Deuxième cycle de l'enseignement secondaire</skos:altLabel>
    <skos:altLabel xml:lang="ru">Шестые классы</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept9291"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept5570">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:26:28+00:00</dct:modified>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">ظروف العمل</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Working conditions</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Condiciones de trabajo</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Conditions de travail</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Условия для труда</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">العوامل المادية والاجتماعية والإدارية المؤثرة على بيئة عمل العامل.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">The physical, social and managerial factors affecting a worker's job environment.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Factores físicos, sociales y administrativos que afectan al entorno de un trabajador.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Facteurs physiques, sociaux et administratifs qui affectent le milieu de travail d'un travailleur.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Физические, социальные и управленческие факторы, влияющие на рабочую обстановку.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">شروط العمل</skos:altLabel>
    <skos:altLabel xml:lang="ar">احوال العمل</skos:altLabel>
    <skos:altLabel xml:lang="ar">اوضاع العمل</skos:altLabel>
    <skos:altLabel xml:lang="en">Labour conditions</skos:altLabel>
    <skos:altLabel xml:lang="es">Condiciones laborales</skos:altLabel>
    <skos:altLabel xml:lang="ru">Условия труда</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept5567"/>
    <skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1169"/>
    <skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept14819"/>
    <skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept2142"/>
    <skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept4536"/>
    <skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept5569"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept7377"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept6944"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3620"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept9775"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept8565"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept5565"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept12462">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
