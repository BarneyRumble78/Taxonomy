  </rdf:Description>
  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept8244">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:35:40+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="fr">Tele-enseignement universitaire</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Teleuniversite</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Universite ouverte</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Universite sans murs</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Universite virtuelle</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">جامعات مفتوحة</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Open universities</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Universidad abierta</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Université ouverte</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Открытые университеты</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">مؤسسات التعليم العالي مع القبول المفتوح التي تقدم برامج الدرجة العلمية الخارجية.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Higher education institutions with open admission that offer external degree programmes.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Institución de enseñanza superior accesible para todos, que ofrece programas externos y otorga diplomas universitarios.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Institution d'enseignement supérieur accessible à tous, qui offre des programmes externes aboutissant sur des diplômes.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Высшие учебные заведения с открытым доступом, предлагающие экстернатные программы получения ученой степени.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">جامعات الاذاعة</skos:altLabel>
    <skos:altLabel xml:lang="en">Radio universities</skos:altLabel>
    <skos:altLabel xml:lang="es">Teleuniversidad</skos:altLabel>
    <skos:altLabel xml:lang="es">Universidad a distancia</skos:altLabel>
    <skos:altLabel xml:lang="es">Universidad on line</skos:altLabel>
    <skos:altLabel xml:lang="es">Universidad sin barreras</skos:altLabel>
    <skos:altLabel xml:lang="es">Universidad virtual</skos:altLabel>
    <skos:altLabel xml:lang="fr">Télé-enseignement universitaire</skos:altLabel>
    <skos:altLabel xml:lang="fr">Téléuniversité</skos:altLabel>
    <skos:altLabel xml:lang="fr">Université sans murs</skos:altLabel>
    <skos:altLabel xml:lang="fr">Université virtuelle</skos:altLabel>
    <skos:altLabel xml:lang="ru">Радиоуниверситеты</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1061"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3335"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3336"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept8243">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-17T16:44:01+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Modulo de autoaprendizaje</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Mallette pedagogique</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Module d'enseignement individualise</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Trousse pedagogique</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Valise pedagogique</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">مجموعات المواد التعلمية</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Learning packages</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Módulo de autoaprendizaje</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Module d'enseignement individualisé</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Учебные комплекты</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">معدات مصممة لتُمكن المتعلمين من التعلم دون مساعدة مستمرة من المعلم: إنه التدريس المحفوظ، المسجل مسبقًا.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Materials designed so that learners can learn from them without much help from a teacher: they are pre-recorded, stored teaching.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Material concebido para permitir al alumno utilizarlo sin la ayuda continua de un profesor. Se trata de una enseñanza memorizada, grabada.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Matériel conçu pour permettre à l'apprenant d'en faire l'exploitation sans l'aide continue d'un enseignant: il s'agit d'enseignement mis en mémoire, pré-enregistré.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Материалы, предназначенные для обучения учащихся без существенного вмешательства со стороны преподавателя</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">как правило, представляют собой записанный на магнитный носитель, сохраненный учебный материал.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">مجموعات تعليم النفس</skos:altLabel>
    <skos:altLabel xml:lang="ar">مجموعات مواد التعلم</skos:altLabel>
    <skos:altLabel xml:lang="en">Learning kits</skos:altLabel>
    <skos:altLabel xml:lang="en">Self instructional packages</skos:altLabel>
    <skos:altLabel xml:lang="es">Material de autoaprendizaje</skos:altLabel>
    <skos:altLabel xml:lang="fr">Mallette pédagogique</skos:altLabel>
    <skos:altLabel xml:lang="fr">Module d'auto-apprentissage</skos:altLabel>
    <skos:altLabel xml:lang="fr">Trousse pédagogique</skos:altLabel>
    <skos:altLabel xml:lang="fr">Valise pédagogique</skos:altLabel>
    <skos:altLabel xml:lang="ru">Комплекты для самообучения</skos:altLabel>
    <skos:altLabel xml:lang="ru">Учебные наборы</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept99"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept81"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept7268"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3389"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept8242"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept9399"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept7291"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept97"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept8242">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:58:14+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="fr">Etudes independantes</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Etudes individuelles</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Etudes libres</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">دراسة مستقلة</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Independent study</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Estudios por libre</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Études libres</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Самостоятельное обучение</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">الدراسة التي يتم إجرائها مع الحد الأدنى أو الغياب الكامل للتوجيه الخارجي. لا ينبغي الخلط مع مصطلح "التعليم الفردي".</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Study carried out with a minimum or a complete absence of external guidance. Do not confuse with "individualized instruction".</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Estudios efectuados con un mínimo o nada de asistencia exterior. No confundir con "enseñanza individualizada".</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Études effectuées avec un minimum ou en l'absence complète d'encadrement extérieur. Ne pas confondre avec "enseignement individualisé".</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Обучение, проводимое при минимальном или полном отсутствии внешнего надзора. Не путать с термином "Индивидуальное обучение".</skos:scopeNote>
    <skos:altLabel xml:lang="ar">دراسة فردية</skos:altLabel>
    <skos:altLabel xml:lang="en">Individual study</skos:altLabel>
    <skos:altLabel xml:lang="fr">Études individuelles</skos:altLabel>
    <skos:altLabel xml:lang="fr">Études indépendantes</skos:altLabel>
    <skos:altLabel xml:lang="ru">Самостоятельное изучение</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept81"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept10332"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3389"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept5930"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept8243"/>
  </rdf:Description>
