    <skos:altLabel xml:lang="es">Neurolingüística</skos:altLabel>
    <skos:altLabel xml:lang="fr">Neurolinguistique</skos:altLabel>
    <skos:altLabel xml:lang="ru">Нейролингвистика</skos:altLabel>
