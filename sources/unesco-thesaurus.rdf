    <skos:altLabel xml:lang="es">Operaciones de mantenimiento de la paz</skos:altLabel>
    <skos:altLabel xml:lang="fr">Force de maintien de la paix</skos:altLabel>
    <skos:altLabel xml:lang="fr">Opération de maintien de la paix</skos:altLabel>
    <skos:altLabel xml:lang="ru">Операции по поддержанию мира</skos:altLabel>
    <skos:altLabel xml:lang="ru">Силы по поддержанию мира</skos:altLabel>
