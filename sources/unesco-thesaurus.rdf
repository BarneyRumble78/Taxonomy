  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept863">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:14:17+00:00</dct:modified>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">ساموا</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Samoa</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Samoa</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Samoa</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Самоа</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">فيما يتعلق بالأحداث التي وقعت قبل سبتمبر ١٩٩٧، استخدم ساموا الغربية.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">For events before September 1997, use Western Samoa.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Para los eventos anteriores a septiembre de 1997, utilizar Samoa occidental.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Pour les événements survenus avant septembre 1997, utiliser Samoa occidental.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">По отношению к событиям, происходившим до сентября 1997 г., используйте термин "Западное Самоа".</skos:scopeNote>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept17034"/>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept856"/>
  </rdf:Description>
