    <skos:altLabel xml:lang="ar">تطوير محلي</skos:altLabel>
    <skos:altLabel xml:lang="ar">تنمية ذاتية</skos:altLabel>
    <skos:altLabel xml:lang="ar">تنمية ذاتية محلية</skos:altLabel>
