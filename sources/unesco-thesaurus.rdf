  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept6585">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:33:45+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Asistencia tecnica</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Ayuda tecnica</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Cooperacion tecnica</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Cooperation technique</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="ru">Техническое содеиствие</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">تعاون تقني</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Technical cooperation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Cooperación técnica</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Coopération technique</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Техническое сотрудничество</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">نقل المهارات وتقديم المشورة للبلدان النامية في مختلف المجالات: الإدارية والعلمية والمهنية والتقنية.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Transfer of skills and provision of advice to developing countries in various fields: administrative, scientific, professional, and technical.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Transferencia de competencias y abastecimiento de material a los países en desarrollo en los ámbitos administrativo, científico, profesional y técnico.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Transfert de compétence et approvisionnement en matériel pour les pays en développement dans divers domaines: administratif, scientifique, professionnel et technique.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Передача отработанных приемов и предоставление консультаций развивающимся странам в различных областях: административной, научной, профессиональной, технической.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">تعاون فني</skos:altLabel>
    <skos:altLabel xml:lang="ar">مساعدة تقنية</skos:altLabel>
    <skos:altLabel xml:lang="ar">مساعدة فنية</skos:altLabel>
    <skos:altLabel xml:lang="en">Technical assistance</skos:altLabel>
    <skos:altLabel xml:lang="es">Asistencia técnica</skos:altLabel>
    <skos:altLabel xml:lang="es">Ayuda técnica</skos:altLabel>
    <skos:altLabel xml:lang="fr">Assistance technique</skos:altLabel>
    <skos:altLabel xml:lang="ru">Техническое содействие</skos:altLabel>
