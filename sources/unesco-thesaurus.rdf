    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:26:13+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Planificacion de la mano de obra</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Planificacion del trabajo</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Planificacion laboral</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="ru">Планирование использования рабочеи силы</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">تخطيط القوى العاملة</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Manpower planning</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Planificación de la mano de obra</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Planification de la main-d'oeuvre</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Планирование использования рабочей силы</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">تحليل وتوقع احتياجات العمل، مع الأخذ في الاعتبار التخطيط الاقتصادي على المدى الطويل.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Analysis and projection of current manpower needs as well as future needs in light of long-term economic planning.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Análisis y previsión de las necesidades de mano de obra así como de las necesidades futuras en términos de planificación económica a largo plazo.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Analyse et prévision des besoins courants en main-d'oeuvre ainsi que les besoins futurs en terme de planification économique à long terme.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Анализ и прогнозирование потребностей в рабочей силе с учетом долгосрочного экономического планирования.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">تخطيط الايدي العاملة</skos:altLabel>
    <skos:altLabel xml:lang="ar">تخطيط التوظيف</skos:altLabel>
    <skos:altLabel xml:lang="ar">تخطيط العمالة</skos:altLabel>
    <skos:altLabel xml:lang="ar">تخطيط العمل</skos:altLabel>
    <skos:altLabel xml:lang="en">Employment planning</skos:altLabel>
    <skos:altLabel xml:lang="en">Labour planning</skos:altLabel>
    <skos:altLabel xml:lang="es">Planificación del trabajo</skos:altLabel>
    <skos:altLabel xml:lang="es">Planificación laboral</skos:altLabel>
    <skos:altLabel xml:lang="fr">Planification de l'emploi</skos:altLabel>
    <skos:altLabel xml:lang="fr">Planification du travail</skos:altLabel>
    <skos:altLabel xml:lang="ru">Планирование занятости</skos:altLabel>
    <skos:altLabel xml:lang="ru">Планирование труда</skos:altLabel>
