  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept311">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:36:27+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Neurolinguistica</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Psicolinguistica</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="ru">Неиролингвистика</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">علم اللغة النفسي</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Psycholinguistics</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Psicolingüística</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Psycholinguistique</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Психолингвистика</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">دراسة العلاقات بين السلوك اللغوي والعمليات النفسية، بما في ذلك عملية اكتساب اللغة.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Study of the relationships between linguistic behaviour and psychological processes, including the process of language acquisition.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Estudio de los procesos de adquisición y elaboración del lenguaje tomando en cuenta la parte psicológica del ser humano.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Discipline qui étudie les processus psychologiques sous-tendant l'utilisation et l'acquisition du langage.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Изучение взаимосвязей между лингвистическим поведением и психологическими процессами, включая процесс приобщения к языку.</skos:scopeNote>
    <skos:topConceptOf rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:altLabel xml:lang="ar">علم اللغة العصبي</skos:altLabel>
