  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept506">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:00:11+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="ar">وثايق ثانوية</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">وثائق ثانوية</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Secondary documents</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Documento secundario</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Document secondaire</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Вторичные документы</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">وثيقة تحتوي على بيانات أو معلومات حول "الوثائق الأساسية".</skos:scopeNote>
    <skos:scopeNote xml:lang="en">A document containing data or information about "primary documents".</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Documento que contiene datos o informaciones sobre "documentos primarios".</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Document contenant des données ou des informations au sujet de "documents primaires".</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Документ, содержащий данные или информацию о "первичных документах".</skos:scopeNote>
