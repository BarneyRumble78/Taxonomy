    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:50:54+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Educacion sobre el desarrollo</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Education sur le developpement</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">تربية تنموية</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Development education</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Educación sobre el desarrollo</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Éducation sur le développement</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Образование в области развития</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">التثقيف بشأن القضايا المهمة في عملية التنمية الموجهة للشباب والكبار في الدول المتقدمة.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Education on the issues of concern in the development process addressed to youth and adults in developed countries.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Educación sobre cuestiones relativas al proceso de desarrollo dirigidas a jóvenes y adultos de los países desarrollados.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Education sur les questions concernant le processus de développement à l'intention des jeunes et des adultes des pays développés.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Образование по вопросам процесса развития, затрагивающим интересы молодежи и взрослого населения развитых стран.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">تعليم التنمية</skos:altLabel>
