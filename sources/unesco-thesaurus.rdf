  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept5929">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:59:11+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="ar">مسوولية تربوية</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Responsabilidad (educacion)</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Responsabilite (education)</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">مسؤولية تربوية</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Educational accountability</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Responsabilidad (educación)</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Responsabilité (éducation)</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Учебная ответственность</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">تحمل المسؤولية عن نتائج أو تبعات محددة لنشاط (والتي يتحمل الفرد المسؤولية عنها).</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Being held responsible and answerable for specific results or outcomes of an activity (over which one has responsibility).</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Responsable último y garante de los resultados específicos y las consecuencias de una actividad de la cual está encargado.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Tenu responsable et garant des résultats spécifiques et des conséquences d'une activité (dont on a la charge).</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Ответственность за конкретные результаты или итоги деятельности, которой поручено заниматься.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">محاسبة تربوية</skos:altLabel>
    <skos:altLabel xml:lang="ar">مساءلة تربویة</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept90"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept9128"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1090"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept7287"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept6151"/>
  </rdf:Description>
