  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept17122">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-04-08T09:58:24+00:00</dct:modified>
