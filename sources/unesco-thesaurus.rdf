  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept1818">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:16:39+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Investigacion agricola</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Investigacion agronomica</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="ru">Исследования в области сельского хозяиства</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">بحث زراعي</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Agricultural research</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Investigación agrícola</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Recherche agricole</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Исследования в области сельского хозяйства</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">تهدف إلى تحسين المحاصيل، وزيادة الغلة، وزيادة القدرة على مقاومة الأمراض.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Designed to improve crops, increase yields, develop resistances to diseases.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Investigación destinada a mejorar las cosechas, aumentar el rendimiento y desarrollar la resistencia a las enfermedades.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Destinée à améliorer les récoltes, accroître le rendement, développer la résistance aux maladies.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Предназначены улучшить сорта зерновых культур, повысить урожайность, выработать устойчивость к болезням.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">بحوث زراعية</skos:altLabel>
    <skos:altLabel xml:lang="es">Investigación agronómica</skos:altLabel>
    <skos:altLabel xml:lang="fr">Recherche agronomique</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept598"/>
  </rdf:Description>
