  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept1489">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-03-02T13:30:13+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Educacion extraescolar</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Educacion paralela</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Education extrascolaire</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Education parallele</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">تعليم خارج المدرسة</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Out of school education</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Educación extraescolar</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Éducation extrascolaire</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Внешкольное образование</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">المؤسسات والبرامج والأنشطة الخاصة بالشباب غير الملتحقين بالمدارس و الأنشطة خارج نطاق المناهج الدراسية لمن هم في المدرسة.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Institutions, programmes and activities for out of school youth and extra-curricular activities for those in school.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Se refiere a las instituciones, programas y actividades para los jóvenes no escolarizados, y a las actividades paraescolares para los jóvenes escolarizados.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Institution, programme et activité pour les jeunes non scolarisés et activité parascolaire pour les jeunes scolarisés.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Учреждения, программы и сферы деятельности для молодежи, завершившей обучение, а также для обучения учащихся вне школьной программы.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">تثقيف خارج المدرسة</skos:altLabel>
    <skos:altLabel xml:lang="ar">تعليم موازي</skos:altLabel>
    <skos:altLabel xml:lang="en">Parallel schooling</skos:altLabel>
    <skos:altLabel xml:lang="es">Educación paralela</skos:altLabel>
    <skos:altLabel xml:lang="fr">Éducation parallèle</skos:altLabel>
    <skos:altLabel xml:lang="ru">Параллельное обучение</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept40"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1473"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1282"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept1482">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-06-03T15:24:36+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Educacion comunitaria</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Educacion social</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Education communautaire</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Education sociale</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">تعليم مجتمعي</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Community education</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Educación comunitaria</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Éducation communautaire</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Образование в рамках местного сообщества</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">العملية التمكينية التي يحصل من خلالها الأطفال والكبار على شعور بالانتماء والتوافق مع مجتمعهم.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Enabling process through which children and adults receive a sense of identification with their community.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Proceso que favorece en los niños y a los adultos el desarrollo de un sentimiento de pertenencia a su comunidad.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Processus favorisant chez l'enfant et l'adulte le développement d'un sentiment d'appartenance à leur communauté.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Познавательный процесс, в рамках которого дети и взрослые обретают чувство единения со своей местной средой.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">تثقيف اجتماعي</skos:altLabel>
