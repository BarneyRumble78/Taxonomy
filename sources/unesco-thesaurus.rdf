  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept116">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-22T15:25:38+00:00</dct:modified>
