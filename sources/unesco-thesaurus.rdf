  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept5917">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:00:13+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Ensenanza correctiva</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Ortopedagogia</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Orthopedagogie</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Remediation</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Remise a niveau</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">تعليم علاجي</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Remedial instruction</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Enseñanza correctiva</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Enseignement correctif</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Обучение отстающих</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">مصممة للحاق بركب موضوع أو مجال معين.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Designed to catch up with a lag in a given subject or field.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Enseñanza concebida para que un alumno retrasado se ponga al día en una materia o área determinada.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Enseignement conçu pour rattrapper un retard dans un sujet ou un domaine particuliers.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Направлено на преодоление пробелов в знаниях по конкретному предмету или в определенной области.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">تعليم تعويضي</skos:altLabel>
    <skos:altLabel xml:lang="ar">تعليم تصحيحي</skos:altLabel>
    <skos:altLabel xml:lang="en">Remedial teaching</skos:altLabel>
    <skos:altLabel xml:lang="es">Ortopedagogía</skos:altLabel>
    <skos:altLabel xml:lang="fr">Orthopédagogie</skos:altLabel>
    <skos:altLabel xml:lang="fr">Remise à niveau</skos:altLabel>
    <skos:altLabel xml:lang="fr">Remédiation</skos:altLabel>
    <skos:altLabel xml:lang="ru">Преподавание отстающим</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept83"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept5914"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept8075"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept5914">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:34:16+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Educacion compensatoria</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Education compensatoire</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">تعليم تعويضي</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Compensatory education</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Educación compensatoria</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Éducation compensatoire</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Компенсирующее образование</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">للطلاب المعاقين أو المحرومين.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">For deprived or disadvantaged students.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Educación para estudiantes desaventajados o desfavorecidos.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Pour les étudiants handicapés ou défavorisés.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Для отстающих учащихся или учащихся с ограниченными возможностями.</skos:scopeNote>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept39"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept5917"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept5916"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept1557">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:58:46+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="ar">استشعار عن بعد</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Teledeteccion</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Telemetria</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Detection a distance</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Teledetection</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Telemesure</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Telemetrie</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Telesurveillance</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">استشعار عن بُعد</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Remote sensing</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Teledetección</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Télédétection</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Дистанционное зондирование</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">نظام متقدم لجمع المعلومات لمراقبة توقعات الحالة الجوية وتطوراتها على سطح الأرض والتعرف على الموارد الطبيعية لمنطقة ما من خلال النظر إلى العالم من الطائرات أو المناطيد أو الأقمار الصناعية وتقييم البيانات التي تم جمعها.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">An advanced system of information gathering to monitor and forecast developments on the surface of the earth and identify an area's natural resources by looking at the world from aircraft, balloons, or satellites and evaluating the data gathered.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Sistema de recogida de información para controlar y prever los movimientos en la superficie terrestre e identificar los recursos naturales de una región, a través de la observación del planeta desde un avión, un globo o un satélite, y la evaluación de los datos obtenidos.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Système de pointe de collecte d'information pour gérer et prévoir les mouvements à la surface de la terre et identifier les ressources naturelles d'une région en observant la planète à partir d'un aéronef, d'un ballon ou de satellites et en évaluant les données recueillies.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Передовая система сбора и анализа данных о состоянии земной поверхности и природных ресурсов в целях мониторинга, прогнозирования и оценки, осуществляемая с борта самолета, с помощью зонда или спутника.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">اجهزة الاستشعار</skos:altLabel>
    <skos:altLabel xml:lang="ar">قياس عن بعد</skos:altLabel>
    <skos:altLabel xml:lang="en">Sensors</skos:altLabel>
    <skos:altLabel xml:lang="en">Telemetry</skos:altLabel>
    <skos:altLabel xml:lang="es">Captor</skos:altLabel>
    <skos:altLabel xml:lang="es">Detector</skos:altLabel>
    <skos:altLabel xml:lang="es">Sonda</skos:altLabel>
    <skos:altLabel xml:lang="es">Telemetría</skos:altLabel>
    <skos:altLabel xml:lang="es">Televigilancia</skos:altLabel>
    <skos:altLabel xml:lang="fr">Capteur</skos:altLabel>
    <skos:altLabel xml:lang="fr">Détection à distance</skos:altLabel>
    <skos:altLabel xml:lang="fr">Sonde</skos:altLabel>
    <skos:altLabel xml:lang="fr">Sonde de mesure</skos:altLabel>
    <skos:altLabel xml:lang="fr">Télémesure</skos:altLabel>
    <skos:altLabel xml:lang="fr">Télémétrie</skos:altLabel>
    <skos:altLabel xml:lang="fr">Télésurveillance</skos:altLabel>
    <skos:altLabel xml:lang="ru">Сенсоры</skos:altLabel>
    <skos:altLabel xml:lang="ru">Телеметрия</skos:altLabel>
