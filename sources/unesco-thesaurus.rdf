    <skos:prefLabel xml:lang="en">Byelorussian SSR</skos:prefLabel>
    <skos:prefLabel xml:lang="es">RSS de Bielorrusia</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">RSS de Biélorussie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Белорусская ССР</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">استخدم للأحداث التي وقعت قبل ١٩٩١. فيما عدا ذلك، استخدم "بيلاروس".</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Use for events before 1991, otherwise, use 'Belarus'.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Se aplica a los eventos anteriores a 1991. En caso contrario, utilizar "Belarrús"</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">S'applique aux événements survenus avant 1991, utiliser autrement "Bélarus".</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Используется по отношению к событиям, происходившим до 1991 г., в иных случаях используйте термин "Беларусь".</skos:scopeNote>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept927"/>
  </rdf:Description>
