    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept10624"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1555"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept4954"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept527"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept11168"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3269"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept615"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept12690"/>
  </rdf:Description>
