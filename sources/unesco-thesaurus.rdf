    <skos:hiddenLabel xml:lang="ar">غلاف الارض المايي</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="ar">غلاف مايي</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="ar">محيط مايي</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Hydrosphere</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">غلاف مائي</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Hydrosphere</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Hidrosfera</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Hydrosphère</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Гидросфера</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">الجزء المائي من الأرض، على سبيل المثال، المحيطات والبحيرات والأنهار.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">That part of the earth that is water e.g. oceans, lakes and rivers.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Parte de la tierra que es agua, como los oceános, los lagos y los ríos.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Partie de la terre correspondant à l'élément "eau", p.ex. les océans, les lacs et les rivières.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Часть поверхности Земли, покрытая водой, например, океанами, озерами, реками и пр.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">غلاف الارض المائي</skos:altLabel>
