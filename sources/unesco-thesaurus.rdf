  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept7281">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-03-21T16:32:49+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Innovacion educacional</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Innovacion educativa</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Innovation educative</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Innovation en education</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">ابتكارات تربوية</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Educational innovations</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Innovación educacional</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Innovation éducative</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Инновации в образовании</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">التغيير في الأهداف أو المحتوى أو الأساليب التي بدأت، كقاعدة، في الأوضاع التجريبية.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Changes in objectives, content or methods initiated, as a rule, in experimental situations.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Cambio de objetivos, de contenidos o de métodos iniciado, por regla general, en situación experimental.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Changement d'objectifs, de contenus ou de méthodes, initié, en règle générale, en situation expérimentale.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Изменения в задачах, содержании или методах, инициируемые, как правило, в рамках экспериментов.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">ابتكارات تعليمية</skos:altLabel>
    <skos:altLabel xml:lang="es">Innovación educativa</skos:altLabel>
    <skos:altLabel xml:lang="fr">Innovation en éducation</skos:altLabel>
