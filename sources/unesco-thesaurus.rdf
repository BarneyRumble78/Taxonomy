  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept4675">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:35:29+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Orientacion profesional</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Counselling de carriere</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Orientation de carriere</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">توجيه مهني</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Vocational guidance</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Orientación profesional</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Orientation professionnelle</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Профессионально-техническая ориентация</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">المساعدة المقدمة للطالب داخل أو خارج النظام المدرسي في اختيار المهنة.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Help given to the individual inside or outside the school system in choosing a career or occupation.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Asistencia proporcionada a un individuo, dentro o fuera del sistema escolar, para facilitarle la elección de una carrera u oficio.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Aide apportée à un individu, dans le cadre ou à l'extérieur du système scolaire, pour faciliter le choix d'une carrière ou d'un métier.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Помощь, оказываемая учащемуся в пределах или за пределами школьной системы в выборе профессии.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">ارشاد وظيفي</skos:altLabel>
    <skos:altLabel xml:lang="ar">توجيه وظيفي</skos:altLabel>
    <skos:altLabel xml:lang="ar">مشورة مهنية</skos:altLabel>
    <skos:altLabel xml:lang="en">Career counselling</skos:altLabel>
    <skos:altLabel xml:lang="en">Career guidance</skos:altLabel>
    <skos:altLabel xml:lang="en">Occupational guidance</skos:altLabel>
    <skos:altLabel xml:lang="es">Asesoramiento profesional</skos:altLabel>
    <skos:altLabel xml:lang="es">Consejo profesional</skos:altLabel>
    <skos:altLabel xml:lang="fr">Counselling de carrière</skos:altLabel>
    <skos:altLabel xml:lang="fr">Counselling professionnel</skos:altLabel>
    <skos:altLabel xml:lang="fr">Orientation de carrière</skos:altLabel>
    <skos:altLabel xml:lang="ru">Консультации по выбору карьеры</skos:altLabel>
    <skos:altLabel xml:lang="ru">Ориентация при выборе карьеры</skos:altLabel>
    <skos:altLabel xml:lang="ru">Профессиональная ориентация</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept30"/>
