  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept7647">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-21T23:41:14+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Dependencia economica</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Teoria de la dependencia</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Dependance economique</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Theorie de la dependance</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">تبعية</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Dependence</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Dependencia</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Dépendance économique</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Зависимость</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">وضع يعتمد فيه اقتصاد بلد ما على النمو الاقتصادي لبلد آخر.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Situation in which a country's economy is subordinated to the development of another country's economy.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Situación según la cual la economía de un país depende del desarrollo económico de otro país.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Situation selon laquelle l'économie d'un pays dépend du développement économique d'un autre pays.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Ситуация, при которой экономика страны подчинена развитию экономики другой страны.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">اعتماد</skos:altLabel>
    <skos:altLabel xml:lang="ar">اعتماد اقتصادي</skos:altLabel>
    <skos:altLabel xml:lang="ar">تبعية اقتصادية</skos:altLabel>
    <skos:altLabel xml:lang="ar">تعويل</skos:altLabel>
    <skos:altLabel xml:lang="ar">نظرية التبعية</skos:altLabel>
    <skos:altLabel xml:lang="en">Dependency theory</skos:altLabel>
    <skos:altLabel xml:lang="en">Economic dependence</skos:altLabel>
    <skos:altLabel xml:lang="es">Dependencia económica</skos:altLabel>
    <skos:altLabel xml:lang="es">Teoría de la dependencia</skos:altLabel>
    <skos:altLabel xml:lang="fr">Théorie de la dépendance</skos:altLabel>
    <skos:altLabel xml:lang="ru">Теория зависимости</skos:altLabel>
    <skos:altLabel xml:lang="ru">Экономическая зависимость</skos:altLabel>
