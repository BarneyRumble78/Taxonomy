    <skos:hiddenLabel xml:lang="es">Alfabetizacion del futuro</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Alfabetizacion en futuros</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Alfabetizacion prospectiva</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Litteratie des futurs</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">قراءة المستقبل</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Futures literacy</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Cultura prospectiva</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Littératie des futurs</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">навыки перспективного анализа</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Skill that allows people to better understand the role of the future in what they see and do.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Compétence qui permet aux individus de mieux comprendre le rôle du futur dans ce qu'ils voient et réalisent.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">القدرة على قراءة المستقبل</skos:altLabel>
    <skos:altLabel xml:lang="es">Alfabetización del futuro</skos:altLabel>
    <skos:altLabel xml:lang="es">Alfabetización en futuros</skos:altLabel>
    <skos:altLabel xml:lang="es">Alfabetización prospectiva</skos:altLabel>
