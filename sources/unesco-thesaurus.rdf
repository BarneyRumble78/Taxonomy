    <skos:hiddenLabel xml:lang="es">Dinamica de la poblacion</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Tendencia demografica</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Changement demographique</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Tendance demographique</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">حراكات سكانية</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Population dynamics</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Dinámica de la población</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Dynamique de la population</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Динамика народонаселения</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">الأنشطة السكانية من حيث الانخفاض أو الزيادة أو الثبات.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Population activity in terms of decline, increase or stabilization.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Se refiere al movimiento demográfico en términos de decadencia, de crecimiento o de estabilización de la población.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Se réfère au mouvement démographique en termes de déclin, d'accroissement ou de stabilisation de la population.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Изменения в показателях численности населения: сокращение, увеличение или стабилизация.</skos:scopeNote>
