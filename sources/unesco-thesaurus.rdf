  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept3451">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:32:28+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="fr">Avantage compare</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">ميزة نسبية</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Comparative advantage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Ventaja comparativa</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Avantage comparatif</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Сравнительное преимущество</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">قدرة بلد ما على توفير منتجات وخدمات معينة بأسعار أرخص نسبيا من أسعار مثيلاتها من المنتجات أو الخدمات.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">A country's ability to provide certain products and services relatively more cheaply than other products or services.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Capacidad de un país de suministrar ciertos productos y servicios relativamente más baratos que otros.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Capacité d'un pays à fournir certains produits et services relativement moins chers que d'autres produits et services.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Способность страны производить определенные товары и услуги по более низкой цене, чем другие товары и услуги.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">ميزة المقارنة</skos:altLabel>
    <skos:altLabel xml:lang="es">Ventaja relativa</skos:altLabel>
    <skos:altLabel xml:lang="fr">Avantage comparé</skos:altLabel>
    <skos:altLabel xml:lang="fr">Avantage relatif</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept584"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3533"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept5895"/>
  </rdf:Description>
