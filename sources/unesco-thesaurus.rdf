    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">اشغال معدنية</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Metalworking</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Trabajo del metal</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Travail du métal</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Металлообработка</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">تشمل الحدادة، عمليات التشكيل، معالجة الصفائح المعدنية، الرسم، البثق، الدرفلة، صنع الأنابيب، إلخ.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Includes forging, forming, sheet metalworking, drawing, extrusion, rolling, tube-making, etc.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Incluye la herrería, la fragua, la fabricación de chapas, la laminación, la fabricación de tubos, el laminado y la extrusión.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Comprend le forgeage, le formage, la tôlerie, l'étirage, l'extrusion, le laminage, la fabrication de tubes, etc.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Включает кузнечные, формовочные операции, обработку металлического листа, вытяжку, экструзию, прокатку, изготовление труб и пр.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">اشغال المعادن</skos:altLabel>
    <skos:altLabel xml:lang="ar">اعمال معدنية</skos:altLabel>
    <skos:altLabel xml:lang="ar">تحويل المعادن</skos:altLabel>
    <skos:altLabel xml:lang="ar">تشكيل الفلزات</skos:altLabel>
    <skos:altLabel xml:lang="ar">صناعات معدنية</skos:altLabel>
