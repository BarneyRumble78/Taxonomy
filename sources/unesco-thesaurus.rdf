  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept1024">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T12:13:04+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="fr">Bulletin de resumes</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Resume</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">مسـتخلصات</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Abstracts</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Resumen</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Résumé</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Рефераты</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">عرض موجز غير نقدي للأعمال العلمية أو الأدب حول الموضوع ، مما يساعد المستخدم على تحديد الفئة التي ينتمي إليها العمل.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">The usually non-critical indication of the subject contents of a document, aiming to permit the user a decision about the relevance of the document.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Información generalmente no crítica sobre el contenido de un documento, encaminada a permitir al usuario apreciar la relevancia de ese documento.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Information généralement non-critique sur le contenu d'un document, visant à permettre à l'usager d'en apprécier la pertinence.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Краткое некритическое изложение научного труда или литературы по теме, помогающее пользователю определить, к какой именно категории относится данный труд.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">مجلات المسـتخلصات</skos:altLabel>
    <skos:altLabel xml:lang="en">Abstract journals</skos:altLabel>
    <skos:altLabel xml:lang="fr">Bulletin de résumés</skos:altLabel>
    <skos:altLabel xml:lang="ru">Реферативные журналы</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3766"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1028"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1022"/>
  </rdf:Description>
