    <skos:hiddenLabel xml:lang="ru">Сербскохорватскии язык</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">لغة صربية كرواتية</skos:prefLabel>
