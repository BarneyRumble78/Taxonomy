  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept2611">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:58:49+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="ru">Тесты на определение склонностеи</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">اختبارات القدرات</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Aptitude tests</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Prueba de aptitud</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Test d'aptitudes</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Тесты на определение склонностей</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">الأدوات المستخدمة لتقييم مجموعة من القدرات الفطرية والمكتسبة والتي تعتبر مؤشرًا على الأداء المستقبلي.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Instruments used to assess a combination of native and acquired abilities which are considered indicative of future performance.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Técnica empleada para evaluar las disposiciones naturales o adquiridas en un individuo con vistas a obtener indicaciones sobre su futuro rendimiento.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Technique utilisée pour évaluer les dispositions naturelles ou acquises chez un individu, et de nature à fournir des indications sur sa performance future.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Средства, используемые для оценки комплекса врожденных и приобретенных способностей, призванных определять будущие результаты работы.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">اختبارات الكفاءة</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1392"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept996"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept546">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T12:20:00+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Ciencia juridica</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">قانون</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Law</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Derecho</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Droit</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Право</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">استخدم للأعمال المتعلقة بعلم القانون. استخدم "التشريع" و"التشريع البيئي" للقوانين الفردية، إلخ.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Use for works concerning the science of law. For individual laws, use "legislation", "environmental legislation", etc.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Se emplea para las obras que se refieren a la ciencia del derecho. Para las leyes específicas utilizar "legislación", "legislación medioambiental", etc.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">S'emploie pour des ouvrages se rapportant à la science du droit. Pour ce qui concerne des lois spécifiques, utiliser "législation", "législation de l'environnement", etc.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Используется по отношению к работам в области юриспруденции. Для отдельных отраслей права используйте термины "Законодательство", "Законодательство в области окружающей среды" и т.д.</skos:scopeNote>
    <skos:topConceptOf rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:altLabel xml:lang="ar">علوم قانونية</skos:altLabel>
    <skos:altLabel xml:lang="en">Legal sciences</skos:altLabel>
    <skos:altLabel xml:lang="es">Ciencia jurídica</skos:altLabel>
    <skos:altLabel xml:lang="fr">Science juridique</skos:altLabel>
    <skos:altLabel xml:lang="ru">Юридические науки</skos:altLabel>
