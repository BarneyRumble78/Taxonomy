  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept17054">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:07:36+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="ar">راس المال الاجتماعي</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Reseau social</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="ru">Социальныи капитал</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">رأس المال الاجتماعي</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Social capital</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Capital social</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Capital social</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Социальный капитал</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">مجموعة من المعايير الاجتماعية، والشبكات الاجتماعية، والعلاقات، والروابط التي يتمتع بها الفرد أو السائدة في جماعة ما.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">A combination of social norms (such as trusts), social networks, relations and ties held by an individual or predominant within a group.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">El conjunto de relaciones, redes y enlaces sociales de un individuo o un grupo.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">L'ensemble des relations, des réseaux de connaissances et des normes possédés par un individu ou un groupe.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Социальные нормы (например, доверительные соглашения), социальные сети, взаимоотношения и связи, которыми пользуется отдельное лицо или которые преобладают в социальной группе.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">روابط اجتماعية</skos:altLabel>
    <skos:altLabel xml:lang="ar">شبكات اجتماعية</skos:altLabel>
    <skos:altLabel xml:lang="ar">علاقات اجتماعية</skos:altLabel>
    <skos:altLabel xml:lang="en">Social networks</skos:altLabel>
    <skos:altLabel xml:lang="en">Social relations</skos:altLabel>
    <skos:altLabel xml:lang="en">Social ties</skos:altLabel>
    <skos:altLabel xml:lang="es">Lazo social</skos:altLabel>
    <skos:altLabel xml:lang="es">Red social</skos:altLabel>
    <skos:altLabel xml:lang="fr">Lien social</skos:altLabel>
    <skos:altLabel xml:lang="fr">Relation sociale</skos:altLabel>
    <skos:altLabel xml:lang="fr">Réseau social</skos:altLabel>
    <skos:altLabel xml:lang="ru">Социальные отношения</skos:altLabel>
    <skos:altLabel xml:lang="ru">Социальные связи</skos:altLabel>
    <skos:altLabel xml:lang="ru">Социальные сети</skos:altLabel>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2005-10-19T00:00:00</dct:created>
