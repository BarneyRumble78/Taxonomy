  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept38">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-17T16:38:31+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Educacion complementaria</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Educacion extensiva</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Education periscolaire</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">تعليم ممتد</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Extension education</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Educación complementaria</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Éducation périscolaire</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Дополнительное образование</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">الأنشطة التوجيهية للمؤسسات التعليمية الموجهة إلى العملاء خارج هيئة الطلاب المباشرة.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Instructional activities of educational institutions directed to clientele outside immediate student body.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Enseñanza impartida por una institución educativa a una serie de personas que no forman parte de la población estudiantil habitual.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Activité éducative dispensée par une institution éducative en direction d'une clientèle ne faisant pas partie de la population étudiante habituelle.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Просветительская деятельность учебных заведений, направленная на аудиторию, непосредственно не относящуюся к кругу учащихся.</skos:scopeNote>
    <skos:topConceptOf rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:altLabel xml:lang="ar">امتداد تعليمي</skos:altLabel>
    <skos:altLabel xml:lang="ar">ملحق تعليمي</skos:altLabel>
    <skos:altLabel xml:lang="en">Educational extension</skos:altLabel>
    <skos:altLabel xml:lang="es">Educación extensiva</skos:altLabel>
    <skos:altLabel xml:lang="fr">Extension de l'enseignement</skos:altLabel>
    <skos:altLabel xml:lang="ru">Внешние формы образования</skos:altLabel>
