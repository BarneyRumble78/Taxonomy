    <skos:hiddenLabel xml:lang="fr">Conge d'etudes</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Conge de formation</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Conge-formation</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="ru">Учебныи отпуск</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">اجازة دراسية</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Educational leave</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Permiso de estudios</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Congé d'études</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Учебный отпуск</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">استخدامها عندما تكون إجازة مدفوعة الأجر أو غير مدفوعة الأجر تُمنح للموظف للأغراض التعليمية.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Use in connection with paid or unpaid leave granted to employees for educational purposes.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Utilizar cuando se trata de un permiso, remunerado o no, otorgado a un empleado con fines educativos.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Utiliser quand il s'agit d'un congé, rémunéré ou non, accordé à un employé à des fins éducatives.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Используется по отношению к оплачиваемому или неоплачиваемому отпуску, предоставляемому сотрудникам в образовательных целях.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">اجازة تعليمية</skos:altLabel>
    <skos:altLabel xml:lang="es">Permiso de formación</skos:altLabel>
    <skos:altLabel xml:lang="fr">Congé de formation</skos:altLabel>
    <skos:altLabel xml:lang="fr">Congé-formation</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept27"/>
  </rdf:Description>
