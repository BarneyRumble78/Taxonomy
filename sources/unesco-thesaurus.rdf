    <skos:hiddenLabel xml:lang="fr">Education et culture</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">تربية وثقافة</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Education and culture</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Educación y cultura</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Éducation et culture</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Образование и культура</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">أخذ العوامل الثقافية بعين الاعتبار في العملية التعليمية.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Taking into consideration of cultural factors in the educational process.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Consideración de los factores culturales en el proceso educativo.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Prise en compte des facteurs culturels dans le processus éducatif.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Учет культурных факторов в образовательном процессе.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">تعليم وثقافة</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept9"/>
    <skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3898"/>
