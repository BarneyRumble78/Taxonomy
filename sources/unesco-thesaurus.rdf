  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept1071">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:29:31+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Libertad de ensenanza</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Liberte de l'enseignement</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">حرية التعليم</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Academic freedom</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Libertad de enseñanza</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Liberté de l'enseignement</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Научная свобода</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">حرية المؤسسات التعليمية في اختيار برامجها الدراسية والبحثية، والمعلمين، لتدريس المواد الدراسية دون قيود خارجية.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Liberty of educational institutions to decide courses and research, and of teachers to teach subjects, without outside coercion.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Libertad para las instituciones educativas de elegir su programa de curso e investigación y, para los profesores, de enseñar las materias sin limitación exterior.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Liberté pour les institutions éducatives de décider de leur programme de cours et de recherches, et pour les enseignants, d'enseigner les matières, sans contrainte extérieure.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Свобода образовательных учреждений в определении методов ведения учебного процесса и научных исследований, а для преподавателей - право вести обучение по предметам без внешнего вмешательства.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">حرية اكاديمية</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3427"/>
    <skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept17174"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept554"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1073"/>
  </rdf:Description>
