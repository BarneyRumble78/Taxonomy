    <skos:altLabel xml:lang="fr">Conférence assistée par ordinateur</skos:altLabel>
    <skos:altLabel xml:lang="fr">Conférence virtuelle</skos:altLabel>
    <skos:altLabel xml:lang="fr">Conférence électronique</skos:altLabel>
    <skos:altLabel xml:lang="fr">Cyberconférence</skos:altLabel>
