  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept2491">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:59:46+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Antologia</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">مختارات ادبية</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Anthologies</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Antología</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Anthologie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Антологии</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">مجموعة أعمال لمؤلفين مختلفين أو مؤلف واحد، تم اختيارها لغرض واحد أو وفق جوانب محددة.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">A collection of works of various authors or of one author selected for a specific purpose or under specific aspects.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Colección de trabajos de varios autores o de un mismo autor seleccionados para un fin determinado o con una perspectiva concreta.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Recueil de morceaux choisis d'un seul ou de plusieurs auteurs, sélectionnés dans un but spécifique ou dans une perspective déterminée.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Сборник произведений различных авторов или одного автора, отобранных для одной цели или по одному признаку.</skos:scopeNote>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept506"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept2493"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept328"/>
  </rdf:Description>
