    <skos:hiddenLabel xml:lang="es">Violencia de genero</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Violencia por razon del genero</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Violence basee sur le genre</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Violence fondee sur le genre</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Violence liee au genre</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">عنف جنساني</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Gender-based violence</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Violencia de género</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Violence fondée sur le genre</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">гендерное насилие</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Violence directed against a person because of that person’s gender, gender identity or gender expression, or which affects persons of a particular gender disproportionately.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Violencia infligida a una persona por su género, su identidad o expresión de género, o como una violencia que afecta de un modo desproporcionado a las personas de un género en particular.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">La violence dirigée contre une personne en raison de son sexe, de son identité ou expression de genre ou la violence qui touche de manière disproportionnée les personnes d'un sexe en particulier.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">العنف الجنساني</skos:altLabel>
    <skos:altLabel xml:lang="es">Violencia por razón del género</skos:altLabel>
    <skos:altLabel xml:lang="fr">Violence basée sur le genre</skos:altLabel>
    <skos:altLabel xml:lang="fr">Violence liée au genre</skos:altLabel>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-08-26T13:01:43+00:00</dct:created>
