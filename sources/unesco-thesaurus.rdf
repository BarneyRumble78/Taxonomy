  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept6924">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-17T16:38:28+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="fr">Culture itinerante</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">زراعة متنقلة</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Shifting cultivation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Cultivo migratorio</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Culture itinérante</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Подсечно-переложное земледелие</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">استخدام الأراضي الزراعية في الزراعة على نحو مؤقت ما دامت خصبة.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Temporary use of agricultural land for cultivation as long as it is fertile.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Empleo de una tierra agrícola para el cultivo durante el tiempo en el que está fertil.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Utilisation temporaire d'une terre agricole pour la culture tant qu'elle reste fertile.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Временная культивация сельскохозяйственных земель в течение срока сохранения их плодородия.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">زراعة التراحيل</skos:altLabel>
    <skos:altLabel xml:lang="ar">زراعة متبدلة</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1777"/>
  </rdf:Description>
