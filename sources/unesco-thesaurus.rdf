  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept5207">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:28:51+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="fr">Science et developpement</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">علم وتنمية</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Science and development</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Ciencia y desarrollo</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Science et développement</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Наука и развитие</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">يشير إلى إدماج العلوم والتكنولوجيا في عملية التنمية.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Refers to the integration of science and technology into the development process.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Se refiere a la integración de la ciencia y de la tecnología en el proceso de desarrollo.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Fait référence à l'intégration de la science et de la technologie dans le processus de développement.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Используется по отношению к проблемам интеграции науки и технологий в процесс развития.</skos:scopeNote>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept114"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept5724"/>
