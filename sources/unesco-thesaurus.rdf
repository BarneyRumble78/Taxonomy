  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept2978">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:16:29+00:00</dct:modified>
