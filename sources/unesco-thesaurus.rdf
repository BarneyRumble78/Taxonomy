  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept11831">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T12:46:45+00:00</dct:modified>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">خدمات الدراسة (التعليم العالي)</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Study service (higher education)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Servicio universitario</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Service universitaire</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Учебная стажировка (высшее образование)</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">جزء اختياري أو إلزامي من برنامج الدراسات حيث يتم منح وحدات دراسية للعمل خارج الحرم الجامعي في مجال الخدمات الاجتماعية أو التنموية، في الحكومة المحلية والمنظمات الصناعية أو غيرها من المنظمات.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Optional or compulsory part of a programme of studies where credit is given for work off-campus in social or development services, local government, and industrial or other organizations.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Parte opcional u obligatoria de un programa de estudios en la que se otorgan créditos por trabajar fuera del campus en un servicio de desarrollo, un servicio social, el gobierno local, una organización industrial u otras organizaciones.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Partie optionnelle ou obligatoire d'un programme d'études en fonction de laquelle un crédit est accordé pour un travail hors campus dans un service de développement ou un service social, un gouvernment local, une organisation industrielle ou autre.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Факультативная или обязательная часть учебной программы, в рамках которой учащийся получает зачетные единицы за работу вне вуза в области социальных услуг или развития, в местных государственных, производственных или иных организациях.</skos:scopeNote>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept7299"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1308"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept14982"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1485"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept14127"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept17139">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-04-17T11:52:00+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="ar">التعليم في حالات الطواري</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Educacion en situacion de emergencia</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Education en situation d'urgence</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">التعليم في حالات الطوارئ</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Education in emergencies</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Educación en situación de emergencia</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Éducation en situation d'urgence</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">يشير إلى فرص التعليم الجيد لجميع الفئات العمرية في حالات الأزمات.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Refers to the quality learning opportunities for all ages  in  situations  of  crisis</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Se réfère à la fourniture de possibilités d’apprentissage de qualité à tous les âges dans les situations de crise.</skos:scopeNote>
    <skos:altLabel xml:lang="en">Emergency education</skos:altLabel>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-05-10T09:55:04+00:00</dct:created>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept205"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept9077"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3168"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept6086">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:59:37+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="ar">عقد الموتمرات الافتراضية</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="ar">عقد الموتمرات بالفيديو</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="ar">عقد الموتمرات عن بعد</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="ar">عقد الموتمرات عن طريق الحاسب</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Conferencia electronica</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Conference assistee par ordinateur</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Conference electronique</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Conference virtuelle</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Cyberconference</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Teleconference</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Teleconference assistee par ordinateur</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Teleconference informatisee</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">عقد المؤتمرات عن بعد</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Teleconferencing</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Teleconferencia</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Téléconférence</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Телеконференцсвязь</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">إجراء مؤتمرات في مواقع متفرقة في وقت واحد باستخدام الفيديو أو الهاتف أو وسيط ذو صلة.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Conducting conferences simultaneously at dispersed locations using video, telephone or related media.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Conferencia organizada simultáneamente desde lugares dispersos empleando el vídeo, el teléfono u otros medios.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Conférence organisée simultanément dans des endroits dispersés, utilisant la vidéo, le téléphone ou autres médias.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Проведение одновременных сеансов связи с разбросанными географическими точками с использованием видео-, телефонных или иных средств.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">عقد المؤتمرات الافتراضية</skos:altLabel>
    <skos:altLabel xml:lang="ar">عقد المؤتمرات بالفيديو</skos:altLabel>
    <skos:altLabel xml:lang="ar">عقد المؤتمرات عن طريق الحاسب</skos:altLabel>
