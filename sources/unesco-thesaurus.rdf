    <skos:hiddenLabel xml:lang="fr">Inegalite culturelle</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">فوارق ثقافية</skos:prefLabel>
