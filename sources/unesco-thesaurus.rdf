    <skos:altLabel xml:lang="es">Complejo turístico</skos:altLabel>
    <skos:altLabel xml:lang="es">Equipamiento turístico</skos:altLabel>
    <skos:altLabel xml:lang="fr">Équipement touristique</skos:altLabel>
    <skos:altLabel xml:lang="ru">Оборудование для туризма</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept370"/>
    <skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1983"/>
