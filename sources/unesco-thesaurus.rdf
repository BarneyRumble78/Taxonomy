    <skos:prefLabel xml:lang="fr">Fondation éducative</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Фонды в сфере образования</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">تقدم المنح أو الأموال لتمويل البحوث والخدمات والمرافق والمعدات.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Provide grants or funds to finance research, services, facilities, equipment.</skos:scopeNote>
