  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept1487">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:28:15+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Educacion y ocio</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Educacion y tiempo libre</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Loisir et education</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">ترفيه وتعليم</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Leisure and education</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Educación y ocio</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Loisir et éducation</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Досуг и образование</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">الأنشطة التي تهدف إلى مساعدة المجموعات أو الأفراد على استخدام وقت فراغهم لتعزيز صحتهم البدنية والعقلية.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Organized activities intended to help individuals or groups use non-work time in a manner conducive to physical and mental well-being.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Actividades encaminadas a ayudar a grupos o individuos a emplear su tiempo libre para que favorezca su bienestar físico y mental.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Activité organisée dans l'intention d'aider des individus ou des groupes à utiliser leur temps libre de manière à favoriser leur bien-être physique et mental.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Организованная деятельность, направленная на оказание содействия отдельным лицам или группам в проведении нерабочего времени с пользой для физического и умственного здоровья.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">تعليم ترفيهي</skos:altLabel>
    <skos:altLabel xml:lang="ar">تعليم في اوقات الفراغ</skos:altLabel>
    <skos:altLabel xml:lang="en">Leisure education</skos:altLabel>
    <skos:altLabel xml:lang="es">Educación y tiempo libre</skos:altLabel>
    <skos:altLabel xml:lang="fr">Formation aux loisirs</skos:altLabel>
    <skos:altLabel xml:lang="ru">Образование во время досуга</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept9"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept7666"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1473"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept367"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept6972"/>
  </rdf:Description>
