  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept13670">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:06:18+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Malnutricion</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">سوء التغذية</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Malnutrition</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Malnutrición</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Malnutrition</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Недоедание</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">يشمل نقص السعرات الحرارية والبروتينات و/أو الفيتامينات.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Includes calorie, protein and/or vitamin deficiencies.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Incluye la falta de calorías, proteínas y/o vitaminas.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Inclue les carences en calories, protéines et/ou vitamines.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Включает недобор калорий, белков и/или витаминов.</skos:scopeNote>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept409"/>
    <skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept8153"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept7996"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept8194"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept12340">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:15:35+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Industrializacion</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Revolucion industrial</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Revolution industrielle</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">تصنيع</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Industrialization</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Industrialización</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Industrialisation</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Индустриализация</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">يشير إلى المرحلة الأولية من التنمية الصناعية.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Refers to the initial stage of industrial development.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Se refiere al estado inicial del desarrollo industrial.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Fait référence au stade initial du développement industriel.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Относится к начальной стадии промышленного развития.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">تحول صناعي</skos:altLabel>
    <skos:altLabel xml:lang="ar">ثورة صناعية</skos:altLabel>
    <skos:altLabel xml:lang="en">Industrial revolution</skos:altLabel>
    <skos:altLabel xml:lang="es">Revolución industrial</skos:altLabel>
    <skos:altLabel xml:lang="fr">Révolution industrielle</skos:altLabel>
    <skos:altLabel xml:lang="ru">Промышленная революция</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept7766"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept7068"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept941"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept8708">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:45:37+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="ar">بحث بييي</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="ar">تحليل بييي</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Analisis ecologico</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Investigacion ecologica</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Analyse ecologique</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Recherche ecologique</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="ru">Экологическии анализ</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">بحث ايكولوجي</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Ecological research</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Investigación ecológica</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Recherche écologique</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Экологические исследования</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">استخدم للأعمال المتعلقة بمشاريع البحث. بالنسبة للأعمال العلمية العامة، استخدم "علم البيئة".</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Use for works dealing with research projects. For general scientific works, use "ecology".</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Se refiere a los trabajos relacionados con proyectos de investigación. Para trabajos científicos generales emplear "ecología".</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Employer pour des ouvrages liés à des projets de recherche. Pour des ouvrages de science générale, utiliser "écologie".</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Используется по отношению к работам в рамках исследовательских проектов. Для работ общего научного характера следует использовать термин "Экология".</skos:scopeNote>
    <skos:altLabel xml:lang="ar">بحث بيئي</skos:altLabel>
    <skos:altLabel xml:lang="ar">بحوث ايكولوجية</skos:altLabel>
    <skos:altLabel xml:lang="ar">تحليل ايكولوجي</skos:altLabel>
    <skos:altLabel xml:lang="ar">تحليل بيئي</skos:altLabel>
    <skos:altLabel xml:lang="en">Ecological analysis</skos:altLabel>
    <skos:altLabel xml:lang="es">Análisis ecológico</skos:altLabel>
    <skos:altLabel xml:lang="fr">Analyse écologique</skos:altLabel>
    <skos:altLabel xml:lang="ru">Экологический анализ</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3964"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept5679">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:51:26+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Formacion de administradores</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Formacion en gestion</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Formation a la gestion</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">تعليم الادارة</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Management education</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Formación de administradores</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Formation des gestionnaires</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Образование в области управления</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">برامج تعليمية لزيادة المهارات الإدارية والإشرافية للمديرين والمتدربين على الإدارة.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Educational programmes to increase managerial and supervisory skills of managers and management trainees.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Programas educativos encaminados a incrementar las capacidades de gestión y de supervisión de los administradores en ejercicio y en prácticas.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Programme d'études conçu pour développer les aptitudes à la gestion et à la supervision des cadres en exercice et des stagiaires en gestion.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Образовательные программы, ориентированные на улучшение навыков управления и надзора у менеджеров и управленческих стажеров.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">تعليم ادارة الاعمال</skos:altLabel>
    <skos:altLabel xml:lang="ar">تعليم تجارى</skos:altLabel>
    <skos:altLabel xml:lang="en">Business education</skos:altLabel>
    <skos:altLabel xml:lang="es">Formación en gestión</skos:altLabel>
    <skos:altLabel xml:lang="fr">Formation à la gestion</skos:altLabel>
    <skos:altLabel xml:lang="ru">Образование в области бизнеса</skos:altLabel>
