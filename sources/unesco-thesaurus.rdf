  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept10018">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:44:31+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="ar">تقييم الاثر البييي</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="ar">تقييم التاثير على البيية</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Evaluacion del impacto ambiental</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Valoracion del impacto ambiental</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Evaluation de l'impact sur l'environnement</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="ru">Оценка воздеиствия на окружающую среду (экологическая экспертиза)</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">تقييم الاثر البيئي</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Environmental impact assessment</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Evaluación del impacto ambiental</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Évaluation de l'impact sur l'environnement</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Оценка воздействия на окружающую среду (экологическая экспертиза)</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">نشاط صُمِم لتحديد وتوقع وتفسير ونقل المعلومات حول العواقب البيئية للسياسات والمشاريع وغيرها.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">An activity designed to identify, predict, interpret and communicate information concerning the environmental consequences of policies, projects etc.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Actividad destinada a identificar, prever, interpretar y comunicar la información relativa a las consecuencias de políticas, proyectos, etc. sobre el medio ambiente.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Activité destinée à identifier, prévoir, interpréter et communiquer l'information ayant trait aux conséquences de politiques, de projets, etc., sur l'environnement.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Любая деятельность, направленная на определение, интерпретацию и передачу информации об экологических последствиях реализации конкретных политики, проектов и пр.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">تقييم التأثير على البيئة</skos:altLabel>
    <skos:altLabel xml:lang="es">Valoración del impacto ambiental</skos:altLabel>
