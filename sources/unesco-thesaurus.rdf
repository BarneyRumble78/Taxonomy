    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:26:18+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Galeria de arte</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">معارض فنية</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Art galleries</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Galería de arte</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Galerie d'art</skos:prefLabel>
