  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept4194">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:58:16+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Circulacion internacional de materiales</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Circulation internationale de materiels</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="ru">Международныи оборот информационных материалов</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">تداول دولي للمواد</skos:prefLabel>
    <skos:prefLabel xml:lang="en">International circulation of materials</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Circulación internacional de materiales</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Circulation internationale de matériels</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Международный оборот информационных материалов</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">تستخدم فقط للإشارة إلى الاتفاقات التي تهدف إلى تسهيل التبادل الدولي للمواد المعدة للأغراض التعليمية والعلمية والثقافية.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Use only in relation to agreements that aim to facilitate the international exchange of materials intended for educational, scientific and cultural purposes.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Utilizar solamente para la indexación de documentos que se refieran a las Convenciones encaminadas a facilitar la circulación internacional de materiales de caracter educativo, científico y cultural.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Utiliser seulement pour l'indexation de documents se rapportant aux Conventions visant à faciliter la circulation internationale des matériels de caractère éducatif, scientifique et culturel.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Использовать только по отношению к соглашениям, целью которых является содействие международному обмену материалами в области образования, науки и культуры.</skos:scopeNote>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept512"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept4193"/>
