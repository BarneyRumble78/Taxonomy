  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept37">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:35:15+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="fr">Systeme d'enseignement</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Systeme educatif national</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">نظم تعليمية</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Educational systems</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Sistema educativo</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Système d'enseignement</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Системы образования</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">إعداد نظام متكامل من المؤسسات والبرامج المترابطة التي توفر التعليم الرسمي وغير الرسمي.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Arrangement into an organic whole of the interdependent institutions and programmes providing formal and nonformal education.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Configuración en un todo orgánico de instituciones y de programas de educación formal y no formal.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Configuration en un tout organique d'institutions et de programmes interdépendants de l'éducation formelle et non formelle.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Объединение в целостную систему независимых программ и институтов, обеспечивающих как официальное, так и неформальное образование.</skos:scopeNote>
    <skos:topConceptOf rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:altLabel xml:lang="ar">نظم تربوية</skos:altLabel>
    <skos:altLabel xml:lang="ar">نظم تعليمية وطنية</skos:altLabel>
    <skos:altLabel xml:lang="en">National educational systems</skos:altLabel>
    <skos:altLabel xml:lang="es">Sistema educacional</skos:altLabel>
    <skos:altLabel xml:lang="es">Sistema educativo nacional</skos:altLabel>
    <skos:altLabel xml:lang="fr">Système éducatif national</skos:altLabel>
    <skos:altLabel xml:lang="ru">Национальные образовательные системы</skos:altLabel>
