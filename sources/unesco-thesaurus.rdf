    <skos:altLabel xml:lang="es">Aproximación participativa</skos:altLabel>
    <skos:altLabel xml:lang="fr">Approche participative</skos:altLabel>
    <skos:altLabel xml:lang="ru">Консенсусный подход</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept378"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept5339"/>
  </rdf:Description>
