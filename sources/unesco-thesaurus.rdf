    <skos:altLabel xml:lang="es">Desarrollo medioambiental</skos:altLabel>
    <skos:altLabel xml:lang="es">Ecodesarrollo</skos:altLabel>
    <skos:altLabel xml:lang="fr">Durabilité de l'environnement</skos:altLabel>
    <skos:altLabel xml:lang="fr">Durabilité écologique</skos:altLabel>
    <skos:altLabel xml:lang="fr">Développement soutenable</skos:altLabel>
    <skos:altLabel xml:lang="fr">Développement viable</skos:altLabel>
