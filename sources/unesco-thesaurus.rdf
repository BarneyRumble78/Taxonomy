  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept17077">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-04-17T11:52:01+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Alfabetizacion informacional</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Competence informationnelle</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Education a l'information</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Maitrise de l'information</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">محو الامية المعلوماتية</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Information literacy</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Alfabetización informacional</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Maîtrise de l'information</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Информационная грамотность</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">يشتمل على الكفاءات اللازمة للتعرف على احتياجات المعلومات وتحديدها وتقييمها وتطبيقها وإنتاجها في إطار السياقات الثقافية والاجتماعية .</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Comprises the competencies to recognize information needs and to locate, evaluate, apply and create information within cultural and social contexts</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Incluye las competencias para reconocer las necesidades de información y para localizar, evaluar, aplicar y crear información dentro de contextos sociales y culturales</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Inclut les compétences nécessaires pour reconnaître les besoins en information et pour localiser, évaluer, appliquer et créer une information dans un contexte culturel et social donné</skos:scopeNote>
    <skos:altLabel xml:lang="ar">ثقافة معلوماتية</skos:altLabel>
    <skos:altLabel xml:lang="ar">دراية معلوماتية</skos:altLabel>
    <skos:altLabel xml:lang="ar">طلاقة معلوماتية</skos:altLabel>
    <skos:altLabel xml:lang="ar">كفاءة معلوماتية</skos:altLabel>
    <skos:altLabel xml:lang="ar">وعي معلوماتي</skos:altLabel>
    <skos:altLabel xml:lang="en">Information competency</skos:altLabel>
    <skos:altLabel xml:lang="en">Information fluency</skos:altLabel>
    <skos:altLabel xml:lang="fr">Compétence informationnelle</skos:altLabel>
    <skos:altLabel xml:lang="fr">Culture de l'information</skos:altLabel>
    <skos:altLabel xml:lang="fr">Culture informationnelle</skos:altLabel>
    <skos:altLabel xml:lang="fr">Éducation à l'information</skos:altLabel>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-10-04T00:00:00</dct:created>
