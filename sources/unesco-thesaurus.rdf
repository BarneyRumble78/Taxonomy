  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept17003">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:07:30+00:00</dct:modified>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">انويت</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Inuit</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Inuit</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Inuit</skos:prefLabel>
