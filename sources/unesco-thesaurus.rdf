  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept17096">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-14T11:49:23+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Adaptacion al cambio climatico</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">تكيف مع تغير المناخ</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Climate change adaptation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Adaptación al cambio climático</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Adaptation au changement climatique</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">المبادرات والتدابير للحد من ضعف النظم الطبيعية والبشرية في مواجهة تأثيرات تغير المناخ الفعلية أو المتوقعة.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Initiatives and measures to reduce the vulnerability of natural and human systems against actual or expected climate change effects</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Initiatives et mesures prises pour réduire la vulnérabilité des systèmes naturels et humains aux effets des changements climatiques réels ou prévus</skos:scopeNote>
    <skos:topConceptOf rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:altLabel xml:lang="en">Adaptation to climate change</skos:altLabel>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2012-08-23T00:00:00</dct:created>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept17111"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept7888"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept8139"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept17097">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-04-17T12:26:18+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="ar">نمو مراع للبيية</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="ar">نمو مراعي للبيية</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Economia ecologica</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Economia verde</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Economie verte</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">اقتصاد اخضر</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Green economy</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Economía verde</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Зеленая экономика</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Économie verte</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">اقتصاد يتسم بانخفاض الانبعاث الكربوني والفعالية في استخدام الموارد والشمول الاجتماعي.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Economy which is low-carbon, resource efficient, and socially inclusive.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Economía que tiene bajas emisiones de carbono, utiliza los recursos de forma eficiente y es socialmente incluyente.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Economie qui se caractérise par un faible taux d'émission de carbone, l'utilisation rationnelle des ressources et l'inclusion sociale.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">اقتصاد مستدام</skos:altLabel>
    <skos:altLabel xml:lang="ar">نمو اخضر</skos:altLabel>
    <skos:altLabel xml:lang="ar">نمو مراع للبيئة</skos:altLabel>
    <skos:altLabel xml:lang="ar">نمو مراعي للبيئة</skos:altLabel>
    <skos:altLabel xml:lang="en">Green growth</skos:altLabel>
    <skos:altLabel xml:lang="en">Sustainable economy</skos:altLabel>
    <skos:altLabel xml:lang="es">Economía ecológica</skos:altLabel>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2012-08-31T00:00:00</dct:created>
