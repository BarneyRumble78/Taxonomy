    <skos:hiddenLabel xml:lang="es">Federacion rusa</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Federation de Russie</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Federation russe</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="ru">Россииская Федерация</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">الاتحاد الروسي</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Russian Federation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Federación de Rusia</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Fédération de Russie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Российская Федерация</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">استخدم للأحداث التي وقعت بعد ١٩٩١.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Use for events after 1991.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Se aplica a los eventos posteriores a 1991.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">S'applique aux événements survenus après 1991.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Используется по отношению к событиям, происходившим после 1991 г.</skos:scopeNote>
    <skos:altLabel xml:lang="es">Federación rusa</skos:altLabel>
    <skos:altLabel xml:lang="fr">Fédération russe</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept899"/>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept933"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept1781">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:44:00+00:00</dct:modified>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">موارد التربة</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Soil resources</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Recursos de suelos</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Ressources en sol</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Почвенные ресурсы</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">استخدم للدلالة على توافر التربة، بشكل أساسي للزراعة.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Use to denote the availability of soil, mainly for cultivation.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Se refiere a la disponibilidad de los suelos, esencialmente para el cultivo.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Utiliser pour signifier la disponibilité des sols, essentiellement pour la culture.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Используется по отношению к наличию почвенных ресурсов, главным образом для целей культивации.</skos:scopeNote>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1780"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept14174"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept6333"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept597"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept8391"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept922">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:36:32+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="fr">Serbie-Montenegro</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">صربيا والجبل الاسود</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Serbia and Montenegro</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Serbia y Montenegro</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Serbie-Monténégro</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Сербия и Черногория</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">استخدم للأحداث التي وقعت بين ٤ فبراير ٢٠٠٣ و٣ يونيو ٢٠٠٦. للأحداث السابقة لهذا التاريخ، استخدم يوغوسلافيا.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Use for events between 4 February 2003 and 3 June 2006. For earlier events, use Yugoslavia.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Se aplica a los eventos del periodo del 4 de febrero de 2003 hasta el 3 de junio de 2006. Para eventos anteriores, emplear Yugoslavia.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">S'applique aux événements survenus entre le 4 février 2003 et le 3 juin 2006. Pour les événements antérieurs, utiliser Yougoslavie.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Используется по отношению к событиям, происходившим в период с 4 февраля 2003 г. по 3 июня 2006 г. Для событий, происходивших ранее, используйте термин «Югославия».</skos:scopeNote>
    <skos:altLabel xml:lang="ar">صربيا ومونتينيجرو</skos:altLabel>
    <skos:altLabel xml:lang="ar">صربيا ومونتينيغرو</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept899"/>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept954"/>
