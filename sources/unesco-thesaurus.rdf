  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept12332">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:08:08+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Area industrial</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Poligono industrial</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="ru">Промышленные раионы</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">مناطق صناعية</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Industrial areas</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Zona industrial</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Zone industrielle</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Промышленные районы</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">مناطق حضرية عادة، ذات كثافة صناعية مرتفعة نسبيًا، إما مخطط لها أو غير مخطط لها.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Areas, usually urban, with a relatively high industrial concentration, either planned or unplanned.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Zona generalmente urbana de alta concentración industrial que crece de manera planificada o sin planificar.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Zone, généralement urbaine, à haute concentration industrielle, qui s'est développée de manière planifiée ou non planifiée.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Как правило, городские районы с высокой концентрацией промышленных предприятий, как плановой, так и неплановой.</skos:scopeNote>
    <skos:altLabel xml:lang="es">Barrio industrial</skos:altLabel>
    <skos:altLabel xml:lang="es">Parque industrial</skos:altLabel>
    <skos:altLabel xml:lang="es">Polígono industrial</skos:altLabel>
    <skos:altLabel xml:lang="es">Recinto industrial</skos:altLabel>
    <skos:altLabel xml:lang="es">Área industrial</skos:altLabel>
    <skos:altLabel xml:lang="fr">Quartier industriel</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept447"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1951"/>
