    <skos:altLabel xml:lang="es">Centro de recursos pedagógicos</skos:altLabel>
    <skos:altLabel xml:lang="fr">Centre de ressources didactiques</skos:altLabel>
    <skos:altLabel xml:lang="fr">Centre de ressources pédagogiques</skos:altLabel>
    <skos:altLabel xml:lang="ru">Центры образовательных ресурсов</skos:altLabel>
