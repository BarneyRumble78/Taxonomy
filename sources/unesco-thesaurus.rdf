    <skos:prefLabel xml:lang="en">Free education</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Enseñanza gratuita</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Enseignement gratuit</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Бесплатное образование</skos:prefLabel>
    <skos:scopeNote xml:lang="fr">Éducation non payante</skos:scopeNote>
    <skos:scopeNote xml:lang="ar">التعليم المقُدم مجانا.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Non fee-paying education.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Educación no pagada.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Образование, предоставляемое бесплатно.</skos:scopeNote>
