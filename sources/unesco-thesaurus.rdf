  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept1477">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:33:37+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Educacion de los trabajadores</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Formacion de los trabajadores</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Education des travailleurs</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Education ouvriere</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="ru">Образование для деятелеи профсоюзного движения</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">تعليم العمال</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Workers education</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Educación de los trabajadores</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Éducation des travailleurs</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Образование для деятелей профсоюзного движения</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">إعداد أعضاء النقابة لتحسين مهاراتهم في إبرام عقود العمل. ينبغي عدم الخلط بينه وبين مصطلح "تعليم الكبار".</skos:scopeNote>
    <skos:scopeNote xml:lang="en">The education of union members to improve their bargaining skills. Do not confuse with "adult education".</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Educación de los miembros de un sindicato para mejorar sus aptitudes en la negociación. No confundir con "educación de los adultos".</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Éducation des membres d'un syndicat pour améliorer leurs aptitudes à la négociation. Ne pas confondre avec "éducation des adultes".</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Подготовка членов профсоюза в целях повышения их навыков в заключении трудовых договоров. Не путать с термином "Образование для взрослого населения".</skos:scopeNote>
    <skos:altLabel xml:lang="ar">تثقيف العمال</skos:altLabel>
    <skos:altLabel xml:lang="ar">ثقافة عمالية</skos:altLabel>
    <skos:altLabel xml:lang="es">Formación de los trabajadores</skos:altLabel>
    <skos:altLabel xml:lang="fr">Formation des travailleurs</skos:altLabel>
    <skos:altLabel xml:lang="fr">Éducation ouvrière</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1473"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1481"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3212"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept685"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept5831">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:51:41+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Educacion de la expresion oral</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Educacion de la locucion</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Ejercitacion de la expresion oral</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Formacion en locucion</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Entrainement a l'expression orale</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Formation a l'expression orale</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">تعليم الكلام</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Speech education</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Educación de la expresión oral</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Entraînement à l'expression orale</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Риторика</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">يشمل جوانب مختلفة من الاتصال الشفوي مثل المناقشة والمحادثة والنقاش والقراءة التفسيرية والدراما.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Includes various aspects of oral communication such as discussion, conversation, debate, interpretative reading and drama.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Comprende diversos aspectos de la comunicación oral tales como la discusión, la conversación, el debate, la lectura y la interpretación dramática.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Comprend divers aspects de la communication orale tels que la discussion, la conversation, le débat, la lecture et l'interprétation dramatiques.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Включает различные аспекты устной коммуникации, такие как дискуссия, беседа, диспут, пересказ прочитанного и драматическое представление.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">تعليم الخطابة</skos:altLabel>
    <skos:altLabel xml:lang="en">Elocution education</skos:altLabel>
    <skos:altLabel xml:lang="es">Educación de la locución</skos:altLabel>
    <skos:altLabel xml:lang="es">Ejercitación de la expresión oral</skos:altLabel>
    <skos:altLabel xml:lang="es">Formación en locución</skos:altLabel>
    <skos:altLabel xml:lang="fr">Formation à l'expression orale</skos:altLabel>
    <skos:altLabel xml:lang="ru">Обучение искусству красноречия</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept54"/>
    <skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept2992"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept14861"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept10648"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1542"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept1473">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-04-17T11:52:00+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="ar">تعليم الكبار متعدد التكافو</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Educacion adulta</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Educacion de adultos</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Formacion dirigida a adultos</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Education des adultes</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Education polyvalente des adultes</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">تعليم الكبار</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Adult education</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Educación de adultos</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Éducation des adultes</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Образование для взрослого населения</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">تقديم فرص التعلم في التنمية المهنية والحرفية والتنمية الشخصية والتنمية الاجتماعية للبالغين.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">The offering of learning opportunities in professional and vocational development, personal development, and social development to adults.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Oferta de formación destinada a adultos para favorecer su desarrollo profesional, técnico, personal y social.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Offre de formation destinée aux adultes pour favoriser leur développement professionnel, technique, personnel et social.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Наличие возможностей для получения образования в целях профессионального, личного и социального развития взрослого населения.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">تعليم الكبار متعدد التكافؤ</skos:altLabel>
    <skos:altLabel xml:lang="en">Polyvalent adult education</skos:altLabel>
    <skos:altLabel xml:lang="es">Educación adulta</skos:altLabel>
    <skos:altLabel xml:lang="es">Formación dirigida a adultos</skos:altLabel>
    <skos:altLabel xml:lang="fr">Formation des adultes</skos:altLabel>
    <skos:altLabel xml:lang="fr">Éducation polyvalente des adultes</skos:altLabel>
    <skos:altLabel xml:lang="ru">Поливалентное образование для взрослого населения</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept37"/>
    <skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1476"/>
