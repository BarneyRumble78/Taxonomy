  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept3057">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:52:36+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="ar">علم التحكم الالي</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Cibernetica</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Cybernetique</skos:hiddenLabel>
