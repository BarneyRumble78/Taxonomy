    <skos:hiddenLabel xml:lang="fr">Patrimoine commun de l'humanite</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">مشاعات عالمية</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Global commons</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Patrimonio común universal</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Patrimoine commun de l'humanité</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Мировые ресурсы</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">ملكية مشتركة لموارد أو مناطق تتشارك فيها جميع الأمم.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Resources or zones that are shared as common property by all nations.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Recursos o zonas consideradas propiedad común de todas las naciones.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Ressources ou zones considérées comme propriété commune à toutes les nations.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Ресурсы или зоны, которые используются как совместная собственность всеми народами.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">تراث عالمي مشترك</skos:altLabel>
    <skos:altLabel xml:lang="ar">مشاعات عامة</skos:altLabel>
