  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept1153">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T12:20:05+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Dominio publico</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="ru">Общественныи сектор экономики</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">ملك عام</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Public domain</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Dominio público</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Domaine public</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Общественный сектор экономики</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">المعلومات المتاحة للجميع، والتي لا يشكل استخدامها انتهاكا لأي حق قانوني، أو لأي التزام بالسرية.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Publicly accessible information, the use of which does not infringe any legal right, or any obligation of confidentiality.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Información a la que el público puede acceder sin infringir ninguna disposición jurídica ni obligación alguna de confidencialidad.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Information publiquement accessible, dont l'utilisation ne porte atteinte à aucun droit légal, ni à aucune obligation de confidentialité.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">املاك الدولة</skos:altLabel>
    <skos:altLabel xml:lang="ar">نطاق عام</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept5325"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3090"/>
