  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept2772">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-24T11:22:13+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="ar">مسيولو المعلومات</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Especialista de la informacion</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Experto de la informacion</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Specialiste de l'information</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">علماء المعلومات</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Information scientists</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Especialista de la información</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Spécialiste de l'information</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Ученые в области информации</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">شخص يعمل على نظرية أو تطبيق المعلوماتية أو علم المعلومات، كالعمل على سبيل المثال بالتحليلات والتصميمات والتنفيذ، إلخ. نظم المعلومات.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">A person who works on the theory or application of informatics or information science, i.e. analyses, designs, implements etc. information systems.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Persona que trabaja en el desarrollo de la teoría y las aplicaciones de la informática o de las ciencias de la información.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Personne travaillant à la théorie ou à l'application de l'informatique ou des sciences de l'information, p.ex., à la conception, la mise en oeuvre, etc. de systèmes d'information.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Лица, занятые теоретическими или прикладными исследованиями в области информатики или информационных наук, т.е. осуществляющие анализ, разработку, реализацию и т.д. информационных систем.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">مسئولو المعلومات</skos:altLabel>
    <skos:altLabel xml:lang="ar">موظفو المعلومات</skos:altLabel>
    <skos:altLabel xml:lang="en">Information officers</skos:altLabel>
    <skos:altLabel xml:lang="es">Experto de la información</skos:altLabel>
    <skos:altLabel xml:lang="fr">Agent d'information</skos:altLabel>
    <skos:altLabel xml:lang="fr">Informatiste</skos:altLabel>
    <skos:altLabel xml:lang="ru">Информационные сотрудники</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept485"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept6096"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept2743"/>
  </rdf:Description>
