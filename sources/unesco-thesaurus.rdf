    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:33:25+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Area de prioridad educativa</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Region de prioridad educativa</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Zone d'education prioritaire</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Zone de priorite educative</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">مناطق ذات اولوية في مجال التعليم</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Educational priority areas</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Zona de prioridad educativa</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Zone de priorité éducative</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Региональные приоритеты в образовании</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">المناطق والمحليات وما إلى ذلك التي تحتاج إلى تدابير تعليمية خاصة.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Regions, localities, etc., in need of special educational action.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Regiones y localidades que necesitan una intervención educativa especial.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Région, localité, etc., où se manifeste le besoin d'une intervention éducative spéciale.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Регионы, местности и пр., нуждающиеся в особых образовательных мерах.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">مجالات تعليمية ذات اولوية</skos:altLabel>
    <skos:altLabel xml:lang="es">Región de prioridad educativa</skos:altLabel>
    <skos:altLabel xml:lang="es">Área de prioridad educativa</skos:altLabel>
    <skos:altLabel xml:lang="fr">Zone d'éducation prioritaire</skos:altLabel>
