  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept5128">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:28:33+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Eleccion de tecnologia</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">اختيار التكنولوجيا</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Choice of technology</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Elección de tecnología</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Choix de technologie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Выбор технологии</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">اتخاذ قرار بشأن طرق العمل بالصناعات كثيفة العمالة أو كثيفة رأس المال والاختيار من بين عمليات التصنيع المتنوعة، إلخ.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Deciding on labour intensive or capital intensive methods, choosing among various manufacturing processes, etc.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Elección de métodos de trabajo en función de la presencia de la mano de obra frente a la presencia de equipos, en función del proceso de manufacturación, etc.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Option à prendre entre des méthodes favorisant l'accroissement de la main-d'oeuvre ou de l'équipement, choix entre différents procédés manufacturiers, etc.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Выбор между трудоемкими и капиталоемкими методами, между различными обрабатывающими процессами и пр.</skos:scopeNote>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept8875"/>
    <skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept2596"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept2600"/>
  </rdf:Description>
