  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept1659">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:07:54+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Envejecimiento de la poblacion</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Societe vieillissante</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">سكان مسنون</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Ageing population</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Envejecimiento de la población</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Vieillissement de la population</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Стареющее население</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">الزيادة المستمرة في عدد السكان المسنين في مجتمع معين، في فترة مطلقة أو نسبية على حد سواء.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Continuing increase of elderly population both in absolute and in proportional terms in a given society.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Crecimiento continuado de la población anciana en una sociedad determinada tanto en cifras absolutas como proporcionalmente.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Augmentation constante de la population vieillissante dans une société donnée, tant en nombre absolu que proportionnel.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Продолжающийся рост числа пожилых людей как в абсолютных, так и в относительных показателях в данном обществе.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">شيخوخة السكان</skos:altLabel>
    <skos:altLabel xml:lang="ar">شيخوخة المجتمع</skos:altLabel>
    <skos:altLabel xml:lang="ar">مجتمع المسنين</skos:altLabel>
