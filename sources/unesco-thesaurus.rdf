    <skos:scopeNote xml:lang="en">Use for events after 1991. Otherwise, use "Byelorussian SSR".</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Se aplica a los eventos posteriores a 1991. En caso contrario, utilizar "RSS de Belarrús".</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">S'applique aux événements survenus après 1991. Utiliser autrement "RSS de Biélorussie".</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Используется по отношению к событиям, происходившим после 1991 г., в иных случаях - Белорусская ССР.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">بيلاروسيا</skos:altLabel>
    <skos:altLabel xml:lang="ar">روسيا البيضاء</skos:altLabel>
    <skos:altLabel xml:lang="es">Belarrusia</skos:altLabel>
    <skos:altLabel xml:lang="es">Bielorrusia</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept899"/>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept933"/>
  </rdf:Description>
