  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept4764">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:51:07+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Documentacion</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">توثيق</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Documentation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Documentación</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Documentation</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Документирование</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">المعالجة المستمرة والمنهجية للوثائق أو البيانات لمستخدمي المعلومات المتخصصين.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">The continuous and systematic processing of documents or data for specialized information users.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Tratamiento continuo y sistemático de documentos o de datos para los usuarios de información especializada.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Traitement continu et systématique de documents ou de données pour des utilisateurs d'information spécialisée.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Непрерывный и систематический процесс обработки документов или данных для информационных пользователей.</skos:scopeNote>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept455"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept2790"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3412"/>
