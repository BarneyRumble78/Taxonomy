    <skos:hiddenLabel xml:lang="ru">Управление лесным хозяиством</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">ادارة الغابات</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Forest management</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Gestión forestal</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Gestion forestière</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Управление лесным хозяйством</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">يشير إلى الجوانب المتعلقة باستخراج الأخشاب وإعادة تشجير الغابات.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Refers to timber extraction and reforestation aspects of forestry.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Se refiere a los aspectos de la explotación forestal y de la reforestación de los bosques.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Se réfère aux aspects exploitation forestière et reboisement de la foresterie.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Относится к производству древесины и лесовосстановительным аспектам лесоводства.</skos:scopeNote>
