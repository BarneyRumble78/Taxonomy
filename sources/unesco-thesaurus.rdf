  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept14703">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:33:26+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Tecnico</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">تقنيون</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Technicians</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Técnico</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Technicien</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Техники</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">رتبة وظيفية أقل من المستوى الوظيفي المهني وأعلى من المستوي الوظيفي الكتابي أو العمّالي.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Below level of professional but above clerical or labour levels.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Por debajo del nivel profesional pero por encima de los niveles de secretariado o de trabajo manual.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">En deça du niveau professionnel mais au-delà des niveaux du secrétariat ou du travail manuel.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Ниже уровня специалистов высшего звена, но выше конторских и неквалифицированных работников.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">فنيون</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept115"/>
    <skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept11835"/>
