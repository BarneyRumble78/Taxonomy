  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept6828">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-21T23:41:16+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Crecimiento economico</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Teoria del crecimiento</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Croissance economique</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Theorie de la croissance</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="ru">Экономическии рост</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">نمو اقتصادي</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Economic growth</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Crecimiento económico</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Croissance économique</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Экономический рост</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">يشير إلى زيادة إنتاج السلع والخدمات. لا تخلط بينه وبين "التنمية الاقتصادية والاجتماعية".</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Refers to the increased output of goods and services. Do not confuse with "economic and social development".</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Se refiere al aumento de la producción de bienes y servicios. No confundir con la noción de "desarrollo económico y social".</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Désigne l'augmentation de la production des biens et services. Ne pas confondre avec la notion de "développement économique et social".</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Подразумевает увеличение объемов производства товаров и услуг. Не путать с термином "Экономическое и социальное развитие".</skos:scopeNote>
    <skos:altLabel xml:lang="ar">نظرية النمو</skos:altLabel>
    <skos:altLabel xml:lang="en">Growth theory</skos:altLabel>
    <skos:altLabel xml:lang="es">Teoría del crecimiento</skos:altLabel>
    <skos:altLabel xml:lang="fr">Théorie de la croissance</skos:altLabel>
    <skos:altLabel xml:lang="ru">Теория роста</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept581"/>
    <skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept17097"/>
    <skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept8787"/>
    <skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept8788"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept4463"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3619"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept5895"/>
