    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:34:10+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Desarrollo endogeno</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Developpement endogene</skos:hiddenLabel>
