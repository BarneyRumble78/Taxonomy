  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept2850">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:16:10+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Agricultura en tierras aridas</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Cultivo en tierras aridas</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Culture seche</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="ru">Агротехнические приемы для засушливых раионов</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="ru">Ведение сельского хозяиства в засушливых раионах</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">زراعة جافة</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Dry farming</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Cultivo en tierras áridas</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Aridoculture</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Агротехнические приемы для засушливых районов</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">نظام لإنتاج المحاصيل في المناطق القاحلة وشبه القاحلة دون استخدام مياه الري.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">A system of producing crops in arid and semi-arid regions without the use of irrigation.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Sistema de producción agrícola en regiones áridas y semiáridas sin posibilidad de irrigación.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Système de production agricole en régions arides et semi-arides sans avoir recours à l'irrigation.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Приемы и методы выращивания сельскохозяйственных культур в засушливых и полузасушливых регионах без применения ирригации.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">زراعة الاراضي الجافة</skos:altLabel>
    <skos:altLabel xml:lang="ar">زراعة بعلية</skos:altLabel>
    <skos:altLabel xml:lang="en">Dry land agriculture</skos:altLabel>
    <skos:altLabel xml:lang="es">Agricultura en tierras áridas</skos:altLabel>
    <skos:altLabel xml:lang="fr">Culture sèche</skos:altLabel>
    <skos:altLabel xml:lang="ru">Ведение сельского хозяйства в засушливых районах</skos:altLabel>
