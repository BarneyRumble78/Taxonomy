  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept828">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:36:55+00:00</dct:modified>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">هونج كونج</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Hong Kong</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Hong Kong</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Hong Kong</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Гонконг</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">استخدم للأحداث التي وقعت قبل ١ يوليو ١٩٩٧. فيما عدا ذلك، استخدم هونغ كونغ الصين.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Use for events before 1 July 1997. Otherwise, use Hong Kong China.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Se aplica a los eventos anteriores al 1 de julio de 1997. En caso contrario, utilizar "Hong Kong China".</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">S'applique aux événements survenus avant le 1er juillet 1997. Autrement, utiliser Hong Kong Chine.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Используется по отношению к событиям, происходившим до 1 июля 1997 г. В иных случаях - "Гонконг КНР".</skos:scopeNote>
    <skos:altLabel xml:lang="ar">هونغ كونغ</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept821"/>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept941"/>
  </rdf:Description>
