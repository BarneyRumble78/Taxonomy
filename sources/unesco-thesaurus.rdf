  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept17134">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-12T10:56:13+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="fr">Apprentissage social et emotionnel</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">التعلم الاجتماعي العاطفي</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Social and emotional learning</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Aprendizaje socioemocional</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Apprentissage social et émotionnel</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">عملية من خلالها يفهم الأطفال والكبار عواطفهم، ويديرونها، ويضعون أهدافًا إيجابية، ويحققونها، ويشعرون بالتعاطف تجاه الآخرين، ويظهرونه، ويكونون علاقات إيجابية، ويحافظون عليها، ويتخذون قرارات مسئولة.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Process through which children and adults understand and manage emotions, set and achieve positive goals, feel and show empathy for others, establish and maintain positive relationships, and make responsible decisions.</skos:scopeNote>
    <skos:altLabel xml:lang="en">Socio-emotional learning</skos:altLabel>
    <skos:altLabel xml:lang="es">Aprendizaje social y emocional</skos:altLabel>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-03-11T10:33:35+00:00</dct:created>
