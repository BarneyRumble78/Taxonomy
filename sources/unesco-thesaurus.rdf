    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:58:36+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="fr">Redacteur</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">محررون</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Editors</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Redactor</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Rédacteur</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Редакторы</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">شخص مسؤول عن محتوى مُحرَر أو إعداده للنشر سواء كان مساهما فيه أو لا.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">A person who is responsible for, or prepares for publication, the contents of a document to which he may or may not have contributed.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Persona responsable de la preparación del contenido de un documento para su publicación, que puede haber contribuido o no a su elaboración.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Personne responsable ou préparant, pour publication, le contenu d'un document auquel il a pu ou non apporter sa contribution.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Лицо, ответственное за подготовку авторского произведения к изданию или отвечающее за его содержание.</skos:scopeNote>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept481"/>
