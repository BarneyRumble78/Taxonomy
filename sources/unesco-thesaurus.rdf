  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept10506">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-22T15:25:28+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Evaluacion sumativa</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Evaluation sommative</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">تقييم تجميعي</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Summative evaluation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Evaluación sumativa</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Évaluation sommative</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Суммативная оценка</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">نوع من التقييم يلخص تأثير وفعالية برنامج أو نشاط بمجرد إتمامه.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">A type of evaluation that sums up the effects and effectiveness of a programme or activity once it is concluded.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Tipo de evaluación que resume los efectos y la eficacia de un programa o de una actividad una vez terminado.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Type d'évaluation résumant les effects et l'efficacité d'un programme ou d'une activité, une fois terminé.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Тип оценки, суммирующий последствия и эффективность программы или деятельности на момент ее реализации.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">تقييم اجمالي</skos:altLabel>
    <skos:altLabel xml:lang="ar">تقييم تلخيصي</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept10507"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept10504"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept11835">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
