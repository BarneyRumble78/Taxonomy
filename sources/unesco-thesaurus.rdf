  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept844">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:16:07+00:00</dct:modified>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">ماكاو</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Macao</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Macao</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Macao</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Макао (Аомынь)</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">استخدم للأحداث التي وقعت قبل ٢٠ ديسمبر ١٩٩٩. فيما عدا ذلك، استخدم ماكاو، الصين.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Use for events before 20 Dec. 1999. Otherwise, use Macao, China</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Se aplica a los eventos anteriores al 20 de diciembre de 1999. En caso contrario, utilizar "Macao, China".</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">S'applique aux événements survenus avant le 20 décembre 1999. Autrement, utiliser Macao, Chine</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Используется по отношению к событиям, происходившим до 20 декабря 1999 г. В иных случаях используйте термин "Макао КНР".</skos:scopeNote>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept821"/>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept936"/>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept17064"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept919"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept845">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:16:44+00:00</dct:modified>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">ماكاو، الصين</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Macao, China</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Macao, China</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Macao, Chine</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Макао КНР</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">استخدم للأحداث التي وقعت بعد ٢٠ ديسمبر ١٩٩٩. فيما عدا ذلك، استخدم ماكاو.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Use for events after 20 Dec. 1999. Otherwise, use Macao.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Se aplica a los eventos posteriores al 20 de diciembre de 1999. En caso contrario, utilizar "Macao".</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">S'applique aux événements survenus après le 20 décembre 1999. Autrement, utiliser Macao.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Используется по отношению к событиям, происходившим после 20 декабря 1999 г. В иных случаях используйте термин "Макао".</skos:scopeNote>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept821"/>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept936"/>
