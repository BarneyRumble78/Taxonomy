    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:33:09+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="ar">اقتصاد جزيي</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Microeconomia</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Microeconomie</skos:hiddenLabel>
