    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:28:46+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Metodologia</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Methodologie</skos:hiddenLabel>
