  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept1522">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-03-02T12:53:52+00:00</dct:modified>
