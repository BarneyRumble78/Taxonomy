    <skos:altLabel xml:lang="es">Gestión de las clases</skos:altLabel>
    <skos:altLabel xml:lang="es">Organización de las clases</skos:altLabel>
    <skos:altLabel xml:lang="fr">Aménagement de la salle de classe</skos:altLabel>
    <skos:altLabel xml:lang="fr">Gestion de la classe</skos:altLabel>
    <skos:altLabel xml:lang="fr">Organisation de la classe</skos:altLabel>
    <skos:altLabel xml:lang="ru">Организация и планировка классной комнаты</skos:altLabel>
    <skos:altLabel xml:lang="ru">Управление учебным классом</skos:altLabel>
