  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept17010">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:00:05+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Biblioteca electronica</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Bibliotheque electronique</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Bibliotheque numerique</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Bibliotheque virtuelle</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">مكتبات رقمية</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Digital libraries</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Biblioteca digital</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Bibliothèque numérique</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Цифровые библиотеки</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">مجموعات منظمة من مصادر المعلومات في شكل رقمي أو إلكتروني، جنبا إلى جنب مع الخدمات المصممة لمساعدة المستفيدين في التعرف على هذه المجموعات واستخدامها.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Organized collections of information resources in digital or electronic format along with the services designed to help users identify and use those collections.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Bibliotecas donde las colecciones están en formato digital o electrónico y puestas a disposición del público a través de sistemas de búsqueda apropiados.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Bibliothèque dont les collections sont traitées en format numérique ou électronique, et mises à la disposition des usagers au moyen de systèmes de recherche appropriés.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Организованные собрания информационных ресурсов в электронном или цифровом формате вместе с услугами, предназначенными помочь пользователям находить и использовать эти ресурсы.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">مكتبات افتراضية</skos:altLabel>
    <skos:altLabel xml:lang="ar">مكتبات الكترونية</skos:altLabel>
    <skos:altLabel xml:lang="en">Electronic libraries</skos:altLabel>
    <skos:altLabel xml:lang="en">Virtual libraries</skos:altLabel>
    <skos:altLabel xml:lang="es">Biblioteca electrónica</skos:altLabel>
    <skos:altLabel xml:lang="es">Biblioteca virtual</skos:altLabel>
    <skos:altLabel xml:lang="fr">Bibliothèque virtuelle</skos:altLabel>
    <skos:altLabel xml:lang="fr">Bibliothèque électronique</skos:altLabel>
    <skos:altLabel xml:lang="ru">Виртуальные библиотеки</skos:altLabel>
    <skos:altLabel xml:lang="ru">Электронные библиотеки</skos:altLabel>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2003-11-17T00:00:00</dct:created>
