  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept3894">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:28:32+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="ar">تعليم ثنايي اللغة</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Educacion bilingue</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">تعليم ثنائي اللغة</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Bilingual education</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Educación bilingüe</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Enseignement bilingue</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Двуязычное образование</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">الحث على تعلم لغة ثانية من خلال توفير دروس منتظمة في كل من اللغة الوطنية ولغة ثانية.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Encouragement of bilingualism through the teaching of regular courses in both the national language and a second language.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Iniciación al bilingüismo mediante la enseñanza al mismo tiempo de cursos en la lengua nacional y en una segunda lengua.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Incitation au bilinguisme en dispensant des cours réguliers à la fois dans la langue nationale et dans une langue seconde.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Содействие в овладении вторым языком при помощи регулярных курсов, преподавание на которых ведется как на родном, так и на иностранном языках.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">تعليم بلغتين</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept17189"/>
