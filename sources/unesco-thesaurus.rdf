  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept1850">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-17T16:38:06+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="ru">Агро- и лесное хозяиство</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">زراعة حراجية</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Agroforestry</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Agrosilvicultura</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Agroforesterie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Агролесоводство</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">زراعة الأشجار والمحاصيل الغذائية و/ أو تربية الثروة الحيوانية في آن واحد على قطعة الأرض ذاتها.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Simultaneous growing of trees with food crops and/or livestock on the same piece of land.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Cultura simultánea de árboles, productos víveres y/o cría de ganado en una misma parcela de tierra.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Culture simultanée d'arbres, de produits vivriers et/ou élevage de bétail sur une même parcelle de terre.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Одновременное выращивание деревьев и зерновых и/или сельскохозяйственных животных на одном и том же участке земли.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">زراعة الغابات</skos:altLabel>
    <skos:altLabel xml:lang="ar">حراجة زراعية</skos:altLabel>
    <skos:altLabel xml:lang="en">Agrisilviculture</skos:altLabel>
    <skos:altLabel xml:lang="en">Forest farming</skos:altLabel>
    <skos:altLabel xml:lang="fr">Agrosylviculture</skos:altLabel>
    <skos:altLabel xml:lang="ru">Агро- и лесное хозяйство</skos:altLabel>
    <skos:altLabel xml:lang="ru">Разведение лесов</skos:altLabel>
