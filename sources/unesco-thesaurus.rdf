    <skos:altLabel xml:lang="fr">Piratage informatique</skos:altLabel>
    <skos:altLabel xml:lang="ru">Компьютерное пиратство</skos:altLabel>
    <skos:altLabel xml:lang="ru">Нарушение авторских прав в области вещания</skos:altLabel>
