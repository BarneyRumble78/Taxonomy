    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">قرصنة</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Piracy</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Piratería</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Piratage</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Нарушение авторских прав</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">نسخ أو استيراد أو توزيع المصنفات المحمية بموجب حقوق المؤلف أو بموجب الحقوق المجاورة دون تصريح.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Unauthorized reproduction, importing or distribution of works protected by copyright or neighbouring rights.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Reproducción, importación o distribución no autorizada de obras protegidas por derechos de autor o por derechos cercanos.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Reproduction, importation ou distribution non autorisées d'oeuvres protégées par droits d'auteurs et droits voisins.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Несанкционированные репродукция, импорт или продажа работ, защищенных авторским правом или смежными правами.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">قرصنة اذاعية</skos:altLabel>
