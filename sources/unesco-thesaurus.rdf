  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept7876">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:34:17+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="ar">استراتيجيات انمايية</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Strategie de developpement</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">استراتيجيات التنمية</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Development strategies</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Estrategia de desarrollo</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Stratégie de développement</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Стратегии развития</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">مجموعة منسقة من البرامج والمشاريع تمليها سياسة التنمية ، وتهدف إلى تحقيق نوع معين من التنمية.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">The coordinated package of programmes and projects dictated by development policy, which aims to achieve a particular kind of development.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Conjunto coordinado de programas y proyectos dictados por una política de desarrollo encaminados a la realización de un modelo particular de desarrollo.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Ensemble coordonné de programmes et projets défini par une politique de développement, et qui vise la réalisation d'un modèle particulier de développement.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Связанный пакет программ и проектов, выработанный в рамках определенной политики и нацеленный на достижение конкретного вида развития.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">استراتيجيات إنمائية</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1800"/>
    <skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept16978"/>
