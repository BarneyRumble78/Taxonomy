  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept3168">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-05-10T14:50:18+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="ru">Гуманитарное содеиствие</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="ru">Гуманитарныи акт</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">مساعدة انسانية</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Humanitarian assistance</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Ayuda humanitaria</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Assistance humanitaire</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Гуманитарная помощь</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">أي مساعدة مادية أو وساطة يقدمها المجتمع الدولي في المناطق المضطربة لدواع إنسانية محضة.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Any material assistance or intercession by the international community in troubled areas for purely humanitarian ends.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Toda asistencia material o mediación de la comunidad internacional en zonas de conflicto con fines estrictamente humanitarios.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Toute assistance matérielle ou action revendicatrice de la communauté internationale en zone de conflit à des fins strictement humanitaires.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Любая материальная помощь или участие международного сообщества в проблемных регионах исключительно в гуманитарных целях.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">عمل انساني</skos:altLabel>
    <skos:altLabel xml:lang="ar">عون انساني</skos:altLabel>
    <skos:altLabel xml:lang="ar">معونة انسانية</skos:altLabel>
