  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept5057">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:35:23+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="ar">تنشية</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="ar">تنشية الاطفال</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Crianza del nino</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Practica educativa tradicional</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Education des enfants</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Pratique educatives traditionnelle</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="ru">Воспитание детеи</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">تنشئة الاطفال</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Child rearing</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Crianza del niño</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Éducation des enfants</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Воспитание детей</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">يشير إلى مجموعة من الممارسات والعادات والمعتقدات الخاصة بالسياق الاجتماعي الثقافي.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Refers to a set of culturally and socially determined practices, customs and beliefs.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Se refiere a un conjunto de prácticas, costumbres y creencias propias a un grupo socio-cultural.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Se réfère à un ensemble de pratiques, coutumes et croyances spécifiques au contexte socio-culturel.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Относится к комплексу приемов, обычаев и убеждений, определенных культурой и обществом.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">ابوة وامومة</skos:altLabel>
    <skos:altLabel xml:lang="ar">تربية الاطفال</skos:altLabel>
