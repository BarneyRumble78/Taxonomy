  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept929">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:14:03+00:00</dct:modified>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">يوغوسلافيا</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Yugoslavia</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Yugoslavia</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Yougoslavie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Югославия</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">استخدم للأحداث التي وقعت قبل٤ فبراير ٢٠٠٣. فيما عدا ذلك، استخدم صربيا وجبل أسود.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Use for events before 4 February 2003. Otherwise, use Serbia and Montenegro.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Se aplica a los eventos anteriores al 4 de febrero de 2003. En caso contrario, utilizar "Serbia-Montenegro".</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">S'applique aux événements survenus avant le 4 février 2003. Autrement, utiliser Serbie-Monténégro.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Используется по отношению к событиям, происходившим до 4 февраля 2003 г. В иных случаях используйте термин "Сербия и Черногория".</skos:scopeNote>
    <skos:altLabel xml:lang="ar">يوجوسلافيا</skos:altLabel>
