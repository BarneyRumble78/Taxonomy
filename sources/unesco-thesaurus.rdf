  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept6096">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:52:34+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Formacion en ciencias de la informacion</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">تعليم علم المعلومات</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Information science education</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Formación en ciencias de la información</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Formation en sciences de l'information</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Образование в области информационных наук</skos:prefLabel>
    <skos:altLabel xml:lang="ar">تدريب في علم المعلومات</skos:altLabel>
    <skos:altLabel xml:lang="en">Information science training</skos:altLabel>
    <skos:altLabel xml:lang="fr">Enseignement des sciences de l'information</skos:altLabel>
    <skos:altLabel xml:lang="ru">Подготовка в области информационных наук</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept71"/>
    <skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept2740"/>
    <skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept2746"/>
