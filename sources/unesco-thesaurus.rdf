  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept428">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:07:08+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Poblacion</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">سكان</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Population</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Población</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Population</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Население</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">استخدم فقط فيما يتعلق بالسكان في بلد أو منطقة محددة. عند الضرورة، استخدم واصفة أكثر تحديدا.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Use only with respect to population of a specific country or region. Otherwise, use more specific descriptor where appropriate.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Se refiere solamente a la población específica de un país particular o de una región. En otro caso, utilizar un descriptor más apropiado.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Se réfère uniquement à la population d'un pays particulier ou d'une région. Autrement, utiliser un descripteur plus précis quand c'est opportun.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Используется только по отношению к населению конкретной страны или региона</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">в иных случаях используйте более точный дескриптор.</skos:scopeNote>
    <skos:topConceptOf rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept15257"/>
