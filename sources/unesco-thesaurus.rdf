  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept4024">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:33:22+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Investigacion biologica</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">بحوث بيولوجية</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Biological research</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Investigación biológica</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Recherche biologique</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Биологические исследования</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">استخدم للأعمال التي تتناول مشروعات البحوث. للأعمال العلمية العامة، استخدم "علم الأحياء".</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Use for works dealing with research projects. For general scientific works, use "biology".</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Se refiere a los trabajos relacionados con proyectos de investigación. Para trabajos científicos generales emplear "biología".</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">S'applique aux travaux liés à des projets de recherche. Pour des travaux scientifiques généraux, utiliser "biologie".</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Используется по отношению к работам, выполняемым в рамках исследовательских проектов. Для научных работ общего плана используйте термин "Биология".</skos:scopeNote>
    <skos:altLabel xml:lang="ar">ابحاث بيولوجية</skos:altLabel>
    <skos:altLabel xml:lang="ar">بحث بيولوجي</skos:altLabel>
