    <skos:prefLabel xml:lang="es">Serbocroata</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Serbo-croate</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Сербскохорватский язык</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">استخدم في حال التعامل مع لغة/لغات الصرب والكروات والبوسنيين كلغة واحدة.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Use for works on the language(s) of the Serbs, Croats and Bosnians treated together as a single language.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Utilizar para las obras sobre la lengua de los serbios, los croatas o los bosnios como entidad.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Utiliser pour les ouvrages traitant d'une ou des langues des serbes, des croates et des bosniaques en tant qu'entité.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Используется по отношению к работам на языке сербов, хорватов и боснийцев, являющемся общим для этих народов.</skos:scopeNote>
    <skos:altLabel xml:lang="fr">Serbocroate</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept12302"/>
  </rdf:Description>
