    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:32:05+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Informatica educativa</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Informatique educative</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">استخدامات الحاسب في التعليم</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Computer uses in education</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Informática educativa</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Informatique éducative</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Области применения компьютера в обучении</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">استخدام أجهزة الحاسب للتعلم والاختبار ولخدمات الطلاب/التلاميذ وخدمات الدعم الإداري للمدارس، إلخ. عند الضرورة، استخدم واصفة أكثر تحديدًا.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">The use of computers for instruction, testing, student/pupil personnel services, school administrative support services, etc. Use more specific descriptor where appropriate.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Empleo de ordenadores para la formación, los tests, los servicios a los estudiantes, los servicios de apoyo a la administración de la educación, etc. Utilizar un descriptor más preciso cuando sea necesario.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Utilisation des ordinateurs pour la formation, les tests, les services aux étudiants, élèves et personnel, les services de soutien à l'administration de l'éducation, etc. Utiliser un descripteur plus précis quand c'est pertinent.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Использование компьютеров для обучения, тестирования, учета студентов/учащихся, поддержки управления учебным учреждением и т.д. В необходимых случаях используйте более точный дескриптор.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">استخدامات الحاسب في التربية</skos:altLabel>
    <skos:altLabel xml:lang="ar">حوسبة تعليمية</skos:altLabel>
    <skos:altLabel xml:lang="en">Educational computing</skos:altLabel>
    <skos:altLabel xml:lang="ru">Компьютеризация сферы образования</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept9"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept520"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept6023"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept6028"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept97"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept6012"/>
  </rdf:Description>
