  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept6622">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:44:56+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Curso de libre eleccion</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Cours a option</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">مقررات اختيارية</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Elective courses</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Curso optativo</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Cours à option</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Факультативные курсы</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">الدورات التي يختارها الطالب بحرية من بين عدد من البدائل.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Courses chosen freely by a student from among a number of alternatives.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Curso elegido libremente por el estudiate entre un cierto número de cursos propuestos.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Cours sélectionné librement par un étudiant parmi un certain nombre de cours proposés.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Курсы, выбираемые по желанию учащегося из числа нескольких альтернатив.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">دورات اختيارية</skos:altLabel>
    <skos:altLabel xml:lang="en">Optional courses</skos:altLabel>
    <skos:altLabel xml:lang="es">Curso de libre elección</skos:altLabel>
    <skos:altLabel xml:lang="es">Curso opcional</skos:altLabel>
    <skos:altLabel xml:lang="ru">Необязательные курсы</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept50"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept6620"/>
  </rdf:Description>
