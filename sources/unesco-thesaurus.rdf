  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept5873">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-17T16:38:27+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Educacion de masas</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Educacion masiva</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Education de masse</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">تعليم جماهيري</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Mass education</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Educación masiva</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Éducation de masse</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Массовое образование</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">تعهد واسع النطاق يهدف إلى نشر المعلومات للتأثير على رأي الجمهور العام. يمكن أن تستخدم أيضًا فيما يتعلق بنشر الثقافة الشعبية.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">A large-scale undertaking aimed at disseminating information to influence the opinion of the general public. May also be used in relation to the propagation of popular culture.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Operación de envergadura encaminada a la diseminación de información para influenciar a la opinión pública general. También puede ser utilizado en el contexto de la propagación de la cultura popular.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Opération d'envergure visant la dissémination d'information pour influencer l'opinion publique générale. Peut s'utiliser aussi dans le contexte de la diffusion de la culture populaire.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Крупномасштабное мероприятие, направленное на распространение информации в целях воздействия на мнение большинства населения</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">также может использоваться в связи с распространением популярной культуры.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">تثقيف جماهيري</skos:altLabel>
    <skos:altLabel xml:lang="ar">تعليم جماعي</skos:altLabel>
    <skos:altLabel xml:lang="es">Educación de masas</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept37"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1482"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept6465"/>
