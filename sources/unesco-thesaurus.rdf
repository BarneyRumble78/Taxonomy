  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept40">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:34:46+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Educacion no formal</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Education non formelle</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">تعليم غير نظامي</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Nonformal education</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Educación no formal</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Éducation non formelle</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Неформальное образование</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">نشاط تعليمي منظم ومنهجي، مرتبط غالبًا بالعمل، يتم توفيره خارج النظام التعليمي الرسمي</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Organized and systematic learning activity, often associated with work, provided outside the formal educational system.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Actividad de aprendizaje organizada y sistemática, a menudo relacionada con el trabajo, impartida al margen del sistema de educación formal.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Activité d'apprentissage organisée et systématique, souvent en relation avec le travail, dispensée en dehors du système d'éducation formelle.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Систематическая учебная деятельность, часто связанная с работой и организованная вне официальной системы образования.</skos:scopeNote>
    <skos:topConceptOf rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept5082"/>
    <skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1475"/>
    <skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1482"/>
    <skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1488"/>
    <skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1489"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept39"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept9352"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept37"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept6829">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:25:54+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="ar">ايتمانات صغيرة</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Microcredito</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Microfinanciacion</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Microcredit</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">ائتمانات صغيرة</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Microcredit</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Microcrédito</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Microcrédit</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Микрокредит</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">دعم مالي مناسب على نطاق صغير من أجل تخفيف حدة الفقر.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Appropriate small-scale financial support for poverty alleviation.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Apoyo financiero apropiado, concebido a pequeña escala, para el alivio de la pobreza.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Support financier approprié, conçu à petite échelle, pour alléger la pauvreté.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Финансовая поддержка в малых размерах для борьбы с бедностью.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">تمويل بالغ الصغر</skos:altLabel>
    <skos:altLabel xml:lang="ar">قروض صغيرة</skos:altLabel>
    <skos:altLabel xml:lang="en">Microfinance</skos:altLabel>
    <skos:altLabel xml:lang="es">Microfinanciación</skos:altLabel>
    <skos:altLabel xml:lang="es">Microfinanciamiento</skos:altLabel>
    <skos:altLabel xml:lang="fr">Microfinance</skos:altLabel>
    <skos:altLabel xml:lang="ru">Микрофинансы</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3570"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept8118"/>
