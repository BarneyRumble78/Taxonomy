    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:32:46+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Cooperacion comercial</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Cooperacion economica</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Cooperacion financiera</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Cooperacion industrial</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Cooperation economique</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">تعاون اقتصادي</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Economic cooperation</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Cooperación económica</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Coopération économique</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Экономическое сотрудничество</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">يشمل تدابير تعاونية بين البلدان في مجال الأعمال المصرفية والتجارة والصناعة وما إلى ذلك.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Includes cooperative measures in banking, trade, industry etc., between and among countries.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Incluye las medidas de cooperación bancaria, comercial, industrial, etc. dentro de los países y entre ellos.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Englobe les mesures de coopération bancaire, commerciale, industrielle, etc., à l'intérieur et entre les pays.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Включает межгосударственные и совместные действия в банковском секторе, торговле, промышленности и пр.</skos:scopeNote>
    <skos:altLabel xml:lang="es">Cooperación comercial</skos:altLabel>
    <skos:altLabel xml:lang="es">Cooperación financiera</skos:altLabel>
    <skos:altLabel xml:lang="es">Cooperación industrial</skos:altLabel>
