  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept7006">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:29:19+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Minoria cultural</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Minorite culturelle</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">اقليات ثقافية</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Cultural minorities</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Minoría cultural</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Minorité culturelle</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Культурные меньшинства</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">مجموعة من الأشخاص ينتمون إلى ثقافة تختلف عن ثقافة غالبية المجتمع الذي يعيشون فيه.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Group of persons belonging to a culture different from that of the majority of the society in which they live.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Grupo de personas pertenecientes a una cultura diferente a la de la mayoría de la sociedad en la que viven.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Groupe de personnes vivant dans une société donnée et appartenant à une culture différente de celle de la majorité.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Группа людей, чья культура отличается от культуры большинства в обществе, где они проживают.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">ثقافات الاقليات</skos:altLabel>
    <skos:altLabel xml:lang="en">Minority cultures</skos:altLabel>
    <skos:altLabel xml:lang="es">Cultura minoritaria</skos:altLabel>
    <skos:altLabel xml:lang="fr">Culture minoritaire</skos:altLabel>
    <skos:altLabel xml:lang="ru">Культуры меньшинств</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept259"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1198"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1970"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept6248"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept420"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept556"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept9669">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:36:48+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Empresa comun</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Empresa en participacion</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">مشروعات مشتركة</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Joint ventures</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Empresa en participación</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Entreprise en participation</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Совместные предприятия</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">مشروع يشمل المؤسسات أو المنظمات التي تجمع بين النظرية والخبرة الفنية ورأس المال و/أو العمل للوصول إلى هدف مشترك.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Project involving enterprises or organizations that combine theory, know-how, capital and/or labour to reach a common objective.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Proyecto que agrupa empresas u organizaciones que ponen en común teoría, forma de trabajar, capital y/o trabajo para alcanzar un objetivo común.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Projet impliquant des entreprises ou des organisations qui associent théorie, savoir-faire, capital et/ou travail pour atteindre un objectif commun.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Проект, в рамках которого предприятия или организации объединяют теоретические знания, ноу-хау, капитал и/или труд для достижения общей цели.</skos:scopeNote>
    <skos:altLabel xml:lang="es">Empresa común</skos:altLabel>
    <skos:altLabel xml:lang="fr">Coentreprise</skos:altLabel>
    <skos:altLabel xml:lang="fr">Entreprise commune</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept669"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept11040"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept9679"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept7007">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:33:23+00:00</dct:modified>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">علاقات ثقافية</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Cultural relations</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Relaciones culturales</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Relations culturelles</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Культурные взаимоотношения</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">علاقات علي المستويين؛ الدولي و بين المجموعات. استخدم واصفة أكثر تحديدا عند الضرورة.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Relations at both the international and intergroup level. Use more specific descriptor where appropriate.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Se refiere tanto a las relaciones internacionales como a las relaciones entre grupos. Utilizar un descriptor más preciso cuando sea necesario.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Se réfère tant aux relations internationales qu'aux relations intergroupes. Utiliser un descripteur plus précis quand c'est pertinent.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Отношения как на международном, так и межгрупповом уровнях. В необходимых случаях используйте более точный дескриптор.</skos:scopeNote>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept272"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept261"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept6248"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept6572"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept6984"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept419"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3897"/>
  </rdf:Description>
