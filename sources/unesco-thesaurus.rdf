    <skos:prefLabel xml:lang="ar">ادارة تربوية</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Gestión educacional</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">تستخدم عندما يتعلق الأمر بإدارة المؤسسات التعليمية.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Use to mean the management of educational establishments.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Utilizar para referirse a la gestión de un establecimiento educativo.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Utiliser quand il s'agit de la gestion d'un établissement éducatif.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Используется для обозначения управления в образовательных учреждениях.</skos:scopeNote>
    <skos:topConceptOf rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
