  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept1088">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-04-17T12:26:18+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Acreditacion (educacion)</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Institucion educativa acreditada</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Accreditation</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Agrement (education)</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Ecole agreee</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">اعتماد (التعليم)</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Accreditation (education)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Acreditación (educación)</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Agrément (éducation)</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Аккредитация (образовательная)</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">الاعتراف والتصديق على المعيار الأكاديمي لمؤسسة تعليمية من قبل هيئة خارجية محايدة ومعترف بها علنا.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Recognition and approval of the academic standards of an educational institution by some external, impartial body of high public esteem.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Reconocimiento y ratificación de las normas académicas de una institución educativa por un organismo externo imparcial reconocido públicamente.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Reconnaissance et ratification de la norme académique d'une institution éducative par un organisme externe impartial, publiquement reconnu.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Признание и одобрение академических стандартов образовательного учреждения независимым органом, пользующимся авторитетом у общественности.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">مدارس معتمدة</skos:altLabel>
    <skos:altLabel xml:lang="en">Accredited schools</skos:altLabel>
    <skos:altLabel xml:lang="es">Colegio acreditado</skos:altLabel>
    <skos:altLabel xml:lang="es">Escuela acreditada</skos:altLabel>
