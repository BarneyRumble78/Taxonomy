  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept12110">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:44:42+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Investigacion hidrologica</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">بحوث هيدرولوجية</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Hydrological research</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Investigación hidrológica</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Recherche hydrologique</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Гидрологические исследования</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">استخدم للأعمال المتعلقة بمشاريع البحث. للأعمال العلمية العامة، استخدم "الهيدرولوجيا".</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Use for works dealing with research projects. For general scientific works, use "hydrology".</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Se refiere a los trabajos relacionados con proyectos de investigación. Para trabajos científicos generales emplear "hidrología".</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">S'applique aux travaux liés à des projets de recherche. Pour des travaux scientifiques généraux, utiliser "hydrologie".</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Используется по отношению к работам в рамках исследовательских проектов. Для работ общего научного характера следует использовать термин "Гидрология".</skos:scopeNote>
    <skos:altLabel xml:lang="ar">بحث هيدرولوجي</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept188"/>
    <skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept7434"/>
  </rdf:Description>
