  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept587">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-21T23:41:24+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Interdependencia economica</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Interdependance</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Interdependance economique</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">اعتماد متبادل</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Interdependence</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Interdependencia</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Interdépendance</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Взаимозависимость</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">الاعتماد الاقتصادي المتبادل بين الدول. وللجهود الحثيثة الرامية إلى تعزيز الروابط الاقتصادية، استخدم "التعاون الاقتصادي"، "التكامل الاقتصادي"، وما إلى ذلك.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Mutual economic dependence among countries. For active efforts to promote closer economic ties, use "economic cooperation", "economic integration", etc.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Mutua dependencia económica entre países. Para referirse a los esfuerzos desplegados para estrechar las relaciones económicas, utilizar "cooperación económica", "integración económica", etc.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Dépendance économique mutuelle entre pays. Pour signifier les efforts déployés pour promouvoir un resserrement des liens économiques, utiliser "coopération économique", "intégration économique", etc.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Взаимная экономическая зависимость между странами</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">по отношению к активным действиям в целях более тесных экономических взаимосвязей используйте термины "Экономическое сотрудничество", "Экономическая интеграция" и т.д.</skos:scopeNote>
    <skos:topConceptOf rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:altLabel xml:lang="ar">اعتماد اقتصادي متبادل</skos:altLabel>
    <skos:altLabel xml:lang="ar">ترابط</skos:altLabel>
    <skos:altLabel xml:lang="ar">ترابط اقتصادي</skos:altLabel>
    <skos:altLabel xml:lang="ar">تكافل</skos:altLabel>
    <skos:altLabel xml:lang="ar">تكافل اقتصادي</skos:altLabel>
    <skos:altLabel xml:lang="en">Economic interdependence</skos:altLabel>
    <skos:altLabel xml:lang="es">Interdependencia económica</skos:altLabel>
    <skos:altLabel xml:lang="fr">Interdépendance économique</skos:altLabel>
    <skos:altLabel xml:lang="ru">Экономическая взаимозависимость</skos:altLabel>
    <skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3929"/>
