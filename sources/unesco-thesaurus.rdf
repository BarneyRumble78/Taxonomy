    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:59:32+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="ru">Инструкторскии персонал</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">مدربون</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Trainers</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Instructor</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Formateur</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Инструкторы</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">الأفراد الذين يوجهون عملية تطوير المهارات من أجل إتقان أحد الفنون أو تحقيق هدف ما.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Persons who direct the practice of skills toward immediate improvement in some art or task.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Personas que dirigen la práctica de técnicas destinadas a la mejora inmediata de un arte o tarea.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Personne dirigeant la pratique de techniques destinées à l'amélioration immédiate d'un art ou d'une tâche quelconques.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Лица, руководящие процессом выработки навыков с целью освоения какого-либо искусства или достижения цели.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">موظفو التدريب</skos:altLabel>
    <skos:altLabel xml:lang="en">Training officers</skos:altLabel>
    <skos:altLabel xml:lang="es">Monitor</skos:altLabel>
    <skos:altLabel xml:lang="fr">Agent de formation</skos:altLabel>
    <skos:altLabel xml:lang="fr">Moniteur</skos:altLabel>
    <skos:altLabel xml:lang="ru">Инструкторский персонал</skos:altLabel>
