  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept829">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:16:10+00:00</dct:modified>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">هونج كونج الصين</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Hong Kong China</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Hong Kong China</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Hong Kong Chine</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Гонконг КНР</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">استخدم للأحداث التي وقعت بعد ١ يوليو ١٩٩٧. فيما عدا ذلك، استخدم هونغ كونغ.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Use for events after 1 July 1997. Otherwise, use Hong Kong</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Se aplica a los eventos posteriores al 1 de julio de 1997. En caso contrario, utilizar "Hong Kong".</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">S'applique aux événements survenus après le 1er juillet 1997. Utiliser autrement Hong Kong.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Используется по отношению к событиям, происходившим после 1 июля 1997 г. В иных случаях - "Гонконг".</skos:scopeNote>
    <skos:altLabel xml:lang="ar">هونج كونج الصينية</skos:altLabel>
    <skos:altLabel xml:lang="ar">هونغ كونغ الصين</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept821"/>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept941"/>
  </rdf:Description>
