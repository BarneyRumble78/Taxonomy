    <skos:prefLabel xml:lang="ar">توافق</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Consensus</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Consenso</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Consensus</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Консенсус</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">رأي يتفق معه كل أو غالبية مجموعة ما.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">An opinion that all or the majority of a group agree with.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Convergencia general de las opiniones en el seno de un grupo.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Convergence générale des opinions au sein d'un groupe.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Мнение, с которым согласны все либо большинство присутствующих.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">اجماع</skos:altLabel>
