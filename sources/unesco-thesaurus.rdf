  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept1518">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T12:09:26+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Alfabetizacion funcional</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Alphabetisation fonctionnelle</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">محو الامية الوظيفية</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Functional literacy</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Alfabetización funcional</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Alphabétisation fonctionnelle</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Функциональная грамотность</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">مفهوم عام يربط معرفة القراءة والكتابة بتحسين الظروف المعيشية.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">General concept of relating literacy to improved living conditions.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Concepto general que asocia la alfabetización a la mejora de las condiciones de vida.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Concept général associant l'alphabétisation à l'amélioration des conditions de vie.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Общее понятие, связывающее грамотность и улучшенные условия жизни.</skos:scopeNote>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1519"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept11264"/>
