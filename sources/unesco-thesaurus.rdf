    <skos:altLabel xml:lang="fr">Pertinence du contenu de l'éducation</skos:altLabel>
    <skos:altLabel xml:lang="fr">Pertinence du curriculum</skos:altLabel>
    <skos:altLabel xml:lang="ru">Актуальность учебного плана</skos:altLabel>
