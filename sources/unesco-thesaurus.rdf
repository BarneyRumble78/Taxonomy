    <skos:altLabel xml:lang="en">Educational change</skos:altLabel>
    <skos:altLabel xml:lang="en">Educational renewal</skos:altLabel>
    <skos:altLabel xml:lang="es">Reforma educacional</skos:altLabel>
    <skos:altLabel xml:lang="es">Reforma educativa</skos:altLabel>
    <skos:altLabel xml:lang="fr">Changement en éducation</skos:altLabel>
    <skos:altLabel xml:lang="fr">Renouveau de l'éducation</skos:altLabel>
    <skos:altLabel xml:lang="fr">Renouveau éducatif</skos:altLabel>
    <skos:altLabel xml:lang="ru">Изменения в области образования</skos:altLabel>
    <skos:altLabel xml:lang="ru">Процесс обновления в области образования</skos:altLabel>
