  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept17132">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-06-27T10:59:56+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="ar">خدمات النظم الايكولوجية</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Servicios ecosistemicos</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Services ecologiques</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Services ecosystemiques</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">خدمات النظم الإيكولوجية</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Ecosystem services</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Servicios ecosistémicos</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Services écosystémiques</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">функции экосистем</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">المزايا التي يحصل عليها المجتمع بفضل تشغيل النظم الإيكولوجية.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Benefits received by society thanks to the functioning of ecosystems.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Beneficios que las personas obtienen de los ecosistemas</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Ensemble des avantages que les populations retirent des écosystèmes.</skos:scopeNote>
    <skos:altLabel xml:lang="fr">Services écologiques</skos:altLabel>
    <skos:altLabel xml:lang="ru">экосистемные услуги</skos:altLabel>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-02-03T12:53:09+00:00</dct:created>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept211"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3964"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept4533"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept17130">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-06-27T11:38:49+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="ar">اطار الموهلات الوطنية</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="ar">اطر الموهلات الوطنية</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="ru">Национальные рамки квалификации</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">أطر المؤهلات الوطنية</skos:prefLabel>
    <skos:prefLabel xml:lang="en">National qualifications framework</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Marco nacional de cualificaciones</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Cadre national de qualification</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Национальные рамки квалификаций</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">إطار المؤهلات الوطني هو أداة تستخدم لتصنيف مؤهلات الدولة على مستويات مختلفة. يتم تحديد كل مستوى من خلال مجموعة من نتائج التعلم المتوقعة على هذا المستوى.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Instrument used to classify a country’s qualifications at different levels. Each level is defined by a set of learning outcomes expected at that level.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Instrumento utilizado para clasificar las cualificaciones de un país en diferentes niveles. Cada nivel está definido por el conjunto de resultados de aprendizaje previstos para ese nivel.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Outil utilisé pour classer les certifications d'un pays à différents niveaux. Chaque niveau est défini par un ensemble de résultats d'apprentissage attendus à ce niveau.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Национальная рамка квалификаций - это инструмент, используемый для классификации квалификаций в стране на различных уровнях. Каждый уровень квалификации определяется набором результатов обучения, ожидаемых на этом уровне.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">إطار المؤهلات الوطنية</skos:altLabel>
    <skos:altLabel xml:lang="fr">Cadre national des certifications</skos:altLabel>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-10-14T08:40:14+00:00</dct:created>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept89"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept36"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1091"/>
  </rdf:Description>
