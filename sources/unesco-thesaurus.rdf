  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept8557">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:34:10+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="ar">اقتصاد ثنايي</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Dualismo economico</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Dualisme economique</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="ru">Экономическии дуализм</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">اقتصاد مزدوج</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Dual economy</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Dualismo económico</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Dualisme économique</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Экономический дуализм</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">نظام اقتصادي تتعايش فيه القطاعات الحديثة كثيفة رأس المال مع القطاعات التقليدية الأفقر.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Economy in which a modern, capital-intensive sector coexists with an impoverished, traditional sector.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Economía en la que un sector moderno capitalista coexiste con un sector empobrecido y tradicional.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Economie dans laquelle un secteur moderne capitalistique coexiste avec un secteur traditionnel appauvri.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Экономика, в которой современный, капиталоемкий сектор сосуществует с обедневшим, традиционным сектором.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">اقتصاد ثنائي</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept583"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept9888">
