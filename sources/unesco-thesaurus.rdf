  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept2089">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:07:04+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Transliteracion</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Translitteration</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">نقحرة</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Transliteration</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Transliteración</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Translittération</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Транслитерация</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">تمثيل الوحدة المعجمية لنظام كتابة واحد عن طريق علامات ورموز لغة أخرى.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Representation of a lexical item recorded in one writing system by means of the signs and symbols of another.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Representación, letra por letra, de la forma gráfica de una unidad léxica de un lenguaje en el sistema de escritura de un otro lenguaje.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Représentation, lettre par lettre, de la forme graphique d'une unité d'une langue dans le système d'écriture d'une autre langue.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Представление лексической единицы одной системы письма средствами знаков и символов другого языка.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">نسخ كتابة لغة بحروف لغة اخرى</skos:altLabel>
    <skos:altLabel xml:lang="ar">نقل حرفي</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept315"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept2010"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept314"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept7510"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept7775">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-04-26T11:43:56+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="ar">استدامة بييية</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="ar">تنمية بييية</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Desarrollo ecologico</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Developpement durable</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Developpement ecologique</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Developpement soutenable</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Developpement viable</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Durabilite de l'environnement</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Durabilite ecologique</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Ecodeveloppement</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Viabilite ecologique</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="ru">Устоичивое развитие</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="ru">Экологическая устоичивость</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">تنمية مستدامة</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Sustainable development</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Desarrollo sostenible</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Développement durable</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Устойчивое развитие</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">التنمية السليمة بيئيا، التي تلبي احتياجات الأجيال الحالية دون الإخلال بقدرة الأجيال المقبلة على تلبية احتياجاتها.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Environmentally sound development, which meets the needs of the present without compromising the ability of future generations to meet their own needs.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Desarrollo medioambiental racional que responde a las necesidades actuales, sin comprometer las posibilidades de las generaciones futuras de satisfacer sus propias necesidades.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Développement environnemental rationnel, qui répond aux besoins actuels sans compromettre la possibilité des générations futures de subvenir à leurs propres besoins.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Развитие, дружественное по отношению к окружающей среде, которое обеспечивает современные потребности, не лишая будущие поколения возможности обеспечивать свои потребности.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">استدامة بيئية</skos:altLabel>
    <skos:altLabel xml:lang="ar">تنمية ايكولوجية</skos:altLabel>
    <skos:altLabel xml:lang="ar">تنمية بيئية</skos:altLabel>
