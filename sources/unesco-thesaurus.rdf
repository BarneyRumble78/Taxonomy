  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept996">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:00:11+00:00</dct:modified>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">استعداد</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Aptitude</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Aptitud</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Aptitude</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Склонность</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">قدرة الفرد المحتملة على أداء مهمة أو مهارة لم يكتسبها من قبل.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">The potential ability of an individual to perform an as yet unlearned task or skill.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Capacidad potencial de un individuo de desempeñar una tarea en la que carece de experiencia.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Capacité potentielle d'un individu à remplir une tâche dont il n'a pas encore l'expérience.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Потенциальная способность человека выполнять до сих пор не изученную задачу или работу.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">قدرات</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept389"/>
    <skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept999"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept2611"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1000"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept993"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept998"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept7021">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:29:13+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="fr">Diversite culturelle</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="ru">Культурныи плюрализм</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">تنوع ثقافي</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Cultural diversity</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Diversidad cultural</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Diversité culturelle</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Культурное разнообразие</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">التعايش داخل مجتمع يتكون من مجموعات متمايزة ثقافيا تتبع أساليب مختلفة في الحياة.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Coexistence within society of culturally differentiated groups which maintain separate ways of life.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Coexistencia, en una sociedad, de grupos culturalmente diferenciados que mantienen modos de vida separados.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Coexistence, dans une société, de groupes culturellement différenciés qui maintiennent des modes de vie séparés.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Сосуществование в одном обществе культурно дифференцированных групп, поддерживающих различные образы жизни.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">تعددية ثقافية</skos:altLabel>
    <skos:altLabel xml:lang="en">Cultural pluralism</skos:altLabel>
    <skos:altLabel xml:lang="es">Pluralismo cultural</skos:altLabel>
    <skos:altLabel xml:lang="fr">Pluralisme culturel</skos:altLabel>
    <skos:altLabel xml:lang="ru">Культурный плюрализм</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept263"/>
    <skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3892"/>
