  <rdf:Description rdf:about="http://vocabularies.unesco.org/thesaurus/concept3814">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-24T11:22:01+00:00</dct:modified>
    <skos:hiddenLabel xml:lang="es">Biblioteca de deposito</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="es">Biblioteca de deposito legal</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Bibliotheque de depot</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Bibliotheque depositaire</skos:hiddenLabel>
    <skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
    <skos:prefLabel xml:lang="ar">مكتبات الايداع</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Depository libraries</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Biblioteca de depósito</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Bibliothèque dépositaire</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Депозитарные библиотеки</skos:prefLabel>
    <skos:scopeNote xml:lang="ar">مكتبة تتلقى نسخ مجانية من كل المنشورات الوطنية أو كل ما تطلبه منها بموجب القانون أو من خلال الاتفاقات.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">A 'library' receiving by law or under arrangements free copies of all or all required national publications.</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Biblioteca que recibe gratuitamente, por ley o por medio de acuerdos, una copia de una parte o del conjunto de las publicaciones nacionales.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Bibliothèque désignée légalement ou au moyen d'un accord pour recevoir gratuitement une copie d'une partie ou de l'ensemble des publications nationales.</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">Библиотека, получающая по закону или в ином порядке бесплатные экземпляры всех или всех требуемых национальных публикаций.</skos:scopeNote>
    <skos:altLabel xml:lang="ar">مكتبات حقوق الطبع والنشر</skos:altLabel>
    <skos:altLabel xml:lang="en">Copyright libraries</skos:altLabel>
    <skos:altLabel xml:lang="es">Biblioteca de depósito legal</skos:altLabel>
    <skos:altLabel xml:lang="fr">Bibliothèque de dépôt</skos:altLabel>
    <skos:altLabel xml:lang="ru">Библиотеки авторских прав</skos:altLabel>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3841"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3090"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept5778"/>
    <skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3825"/>
  </rdf:Description>
