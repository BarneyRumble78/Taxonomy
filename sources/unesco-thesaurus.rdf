    <skos:hiddenLabel xml:lang="ar">دايرة انتخابية</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Partie concernee</skos:hiddenLabel>
    <skos:hiddenLabel xml:lang="fr">Partie interessee</skos:hiddenLabel>
