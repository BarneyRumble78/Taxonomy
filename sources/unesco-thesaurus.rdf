    <skos:prefLabel xml:lang="ar">جمهورية مولدوفا الاشتراكية السوفيتية</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Moldavian SSR</skos:prefLabel>
    <skos:prefLabel xml:lang="es">RSS de Moldavia</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">SSR de Moldavie</skos:prefLabel>
    <skos:prefLabel xml:lang="ru">Молдавская ССР</skos:prefLabel>
    <skos:scopeNote xml:lang="ru">Используется по отношению к событиям, происходившим до 1991 г.</skos:scopeNote>
    <skos:scopeNote xml:lang="ar">استخدم للأحداث التي وقعت قبل ١٩٩١. فيما عدا ذلك، استخدم "جمهورية مولدوفا".</skos:scopeNote>
    <skos:scopeNote xml:lang="en">Use for events before 1991, otherwise, use "Moldova R".</skos:scopeNote>
    <skos:scopeNote xml:lang="es">Se aplica a eventos anteriores a 1991, en caso contrario, utilice "República de Moldova".</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">S'applique à des événements survenus avant 1991, utiliser autrement "Moldova R".</skos:scopeNote>
    <skos:scopeNote xml:lang="ru">в иных случаях – Республика Молдова.</skos:scopeNote>
    <skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept927"/>
  </rdf:Description>
