{
  "field": "MA",
  "introduction": {
    "situation": "Mathematics spans abstract objects, the continuum, chance and uses in other sciences.",
    "complication": "Published schemes mix subject areas, applications and container headings, so the topics overlap and repeat.",
    "question": "How is everything in mathematics divided?",
    "answer": "Mathematics is divided by the role a claim plays, into foundations and the discipline itself, algebraic and combinatorial structure, space and shape, change and chance, and the modelling and computing of claims from other fields, in that order."
  },
  "governing_thought": "Mathematics is divided by the role a claim plays, into foundations and the discipline itself, algebraic and combinatorial structure, space and shape, change and chance, and the modelling and computing of claims from other fields, in that order.",
  "key_line": {
    "logic_type": "inductive",
    "plural_noun": "roles",
    "mece_dimension": "role the claim plays in mathematics (foundation, structure, space, change and chance, or modelling)",
    "basis": "parts",
    "order": "structure",
    "rank_note": "The pillars run from what underlies all mathematics, through its internal objects, to its use outside itself.",
